{
  "name": "@srenautix/app",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "SreNautix 中心：server、worker、mcp 三个角色共用的镜像入口",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@fastify/cookie": "11.1.3",
    "@kubernetes/client-node": "2.0.0",
    "@srenautix/contract": "workspace:*",
    "@srenautix/core": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "fastify": "5.12.7",
    "jsonpath-plus": "11.2.1",
    "openid-client": "6.8.8",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
