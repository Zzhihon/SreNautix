{
  "name": "@srenautix/app",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "SreNautix 中心：server、worker、mcp 三个角色共用的镜像入口",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:live": "vitest run --project live",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@fastify/cookie": "11.1.3",
    "@kubernetes/client-node": "2.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@srenautix/contract": "workspace:*",
    "@srenautix/core": "workspace:*",
    "@srenautix/integration-sdk": "workspace:*",
    "@srenautix/packs-sdk": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "diff": "9.0.0",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "js-tiktoken": "1.0.21",
    "jsonc-parser": "3.3.1",
    "jsonpath-plus": "11.2.1",
    "jsonrepair": "3.15.0",
    "openai": "7.39.0",
    "openid-client": "6.8.8",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "pure-rand": "8.4.2",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.27.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.23.1",
    "htmlparser2": "12.0.0",
    "oidc-provider": "9.12.2",
    "tough-cookie": "6.0.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
