{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srenautix.io/contract/integrations/changes/v1/changes.schema.json",
  "title": "ChangesContract",
  "description": "changes 集成契约 v1（DESIGN §10.3）：changes.list(scope, window) → ChangeEvent[]。每个适配器都要把变更映射到拓扑节点：Argo CD 用 status.resources，Flux 用 inventory，CI 用镜像 digest 关联到运行中的 Pod，通用 git 适配器按仓库路径声明。适配器必须遵守回放时钟窗口：只返回 window 内的变更",
  "$defs": {
    "ListRequest": {
      "title": "ChangesListRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "window"],
      "properties": {
        "scope": { "$ref": "#/$defs/Scope" },
        "window": { "$ref": "../../../schemas/common.schema.json#/$defs/TimeWindow" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 }
      }
    },
    "Scope": {
      "title": "ChangesScope",
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_id", "namespaces", "components"],
      "properties": {
        "cluster_id": { "$ref": "../../../schemas/common.schema.json#/$defs/ClusterId" },
        "namespaces": {
          "type": "array",
          "description": "空数组表示不按命名空间过滤",
          "items": { "type": "string" }
        },
        "components": {
          "type": "array",
          "description": "空数组表示不按组件过滤",
          "items": { "$ref": "../../../schemas/common.schema.json#/$defs/ComponentKey" }
        }
      }
    },
    "ListResponse": {
      "title": "ChangesListResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["changes", "truncated"],
      "properties": {
        "changes": { "type": "array", "items": { "$ref": "#/$defs/ChangeEvent" } },
        "truncated": { "type": "boolean" }
      }
    },
    "ChangeEvent": {
      "title": "ChangeEvent",
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "source", "kind", "refs", "revision", "actor", "time", "link", "targets", "summary"],
      "properties": {
        "change_id": {
          "type": "string",
          "description": "<source>:<来源内唯一标识>，用于去重"
        },
        "source": {
          "type": "string",
          "description": "集成实例 id，例如 argocd、flux、k8s-rollout、github"
        },
        "kind": {
          "type": "string",
          "description": "rollout：新 ReplicaSet/ControllerRevision；config：挂载的 ConfigMap 版本变化；cordon；scale：HPA 或手动扩缩；gitops_sync：Argo/Flux 同步；ci_deploy：CI 部署；operator：Operator 发起的切换或升级；runtime_config：经管理接口或数据库直接生效的运行时配置变更，不经过 Git 与发布（契约 2.29.0，SQL 审计表变更源读到的记录）；retire：工作负载被删除或副本缩到 0 并保持，目标是这些工作负载与管理它们的 GitOps 应用（契约 2.33.0，从 kube-state-metrics 推导）；other",
          "enum": [
            "rollout",
            "config",
            "cordon",
            "scale",
            "gitops_sync",
            "ci_deploy",
            "operator",
            "runtime_config",
            "retire",
            "other"
          ]
        },
        "refs": {
          "type": "array",
          "description": "来源中的引用，例如 Application 名、PR 号、流水线运行 id",
          "items": { "type": "string" }
        },
        "revision": { "type": ["string", "null"] },
        "previous_revision": {
          "type": ["string", "null"],
          "description": "变更之前的版本（版本标签的旧取值）；与更早一次变更的 revision 相同时，这次变更是回退。来源不知道旧版本时省略或为 null"
        },
        "actor": { "type": ["string", "null"] },
        "time": { "$ref": "../../../schemas/common.schema.json#/$defs/Timestamp" },
        "link": { "type": ["string", "null"] },
        "targets": {
          "type": "array",
          "description": "变更触及的拓扑节点",
          "items": { "$ref": "../../../schemas/common.schema.json#/$defs/ComponentKey" }
        },
        "summary": {
          "type": "string",
          "description": "不可信文本，只作为文本显示",
          "maxLength": 500
        },
        "paths": {
          "type": "array",
          "description": "按仓库路径映射目标的变更源（GitHub）：提交改动的文件命中的路径前缀（配置的 paths[].prefix），按配置顺序。只用于展示关联依据，目标已经由这些前缀映射得出（契约 2.37.0）",
          "items": { "type": "string" }
        },
        "attachments": {
          "type": "array",
          "description": "推导出的变更挂上的前置对象及推导依据（ADR 0104 §13），例如发布之前的迁移 Job。basis：managed_by（与发布由同一个应用管理：managed_by 边或 Argo 的 instance 标签）、revision_label（配置的版本标签取值与发布的相同，例如 cchp.io/release-id）、image（Pod 镜像与发布新 ReplicaSet 的镜像相同）、namespace_window（只按同一命名空间与时间窗推断，是弱推导）",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "basis"],
            "properties": {
              "target": { "$ref": "../../../schemas/common.schema.json#/$defs/ComponentKey" },
              "basis": { "type": "string", "enum": ["managed_by", "revision_label", "image", "namespace_window"] }
            }
          }
        },
        "scrape_jobs": {
          "type": "array",
          "description": "kind 为 retire 时：退役之后失去全部抓取目标的抓取 job（up 序列的 job 标签）。它们的目标在退役之前的 1 小时内都是被退役工作负载的 Pod（契约 2.33.0）",
          "items": { "type": "string" }
        },
        "planned_by": {
          "type": "array",
          "description": "kind 为 retire 时：退役之前 24 小时内最近一次触及被退役的工作负载、管理它们的 GitOps 应用或这些应用的上层应用的 Git 提交（变更源的变更）。非空表示计划内的退役：先合并 Git 提交，再经同步或按提交清理把工作负载删除或缩到 0（契约 2.33.0）",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["change_id", "revision", "time", "link", "summary"],
            "properties": {
              "change_id": { "type": "string" },
              "revision": { "type": ["string", "null"] },
              "time": { "$ref": "../../../schemas/common.schema.json#/$defs/Timestamp" },
              "link": { "type": ["string", "null"] },
              "summary": { "type": "string", "description": "不可信文本，只作为文本显示", "maxLength": 500 }
            }
          }
        },
        "pending_sync": {
          "type": "array",
          "description": "Git 提交触及、在提交之后一直处于 OutOfSync 的 Argo CD 应用：提交已经合并，应用还没有同步到与 Git 一致。out_of_sync_since 是应用最近一次离开 Synced 的时刻，回看范围内一直没有 Synced 时为 null。由 server 在计算事件时按 argocd_app_info 标出，不写入变更源（契约 2.33.0）",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["application", "out_of_sync_since"],
            "properties": {
              "application": { "$ref": "../../../schemas/common.schema.json#/$defs/ComponentKey" },
              "out_of_sync_since": {
                "oneOf": [{ "type": "null" }, { "$ref": "../../../schemas/common.schema.json#/$defs/Timestamp" }]
              }
            }
          }
        }
      }
    }
  }
}
