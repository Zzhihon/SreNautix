{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srenautix.io/contract/model/hypothesize.schema.json",
  "title": "HypothesizeOutput",
  "description": "阶段 B hypothesize 步骤的模型输出（DESIGN §7.2）。遵守可移植 schema 子集（§8.2）：扁平结构、所有字段必填、additionalProperties=false、使用枚举、不使用 oneOf。x-srenautix-dynamic-enum 标出的字段在每次运行时由 worker 替换为本次运行中存在的取值；sample_refs 是有错误样例的卡（契约 2.42.0，ADR 0177）",
  "x-srenautix-portable": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["hypotheses", "next_checks"],
  "properties": {
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "description": "假设树，用 parent_id 表示层级",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parent_id", "root_component", "mechanism", "mechanism_refs", "supporting", "refuting"],
        "properties": {
          "id": { "type": "string", "enum": ["h1", "h2", "h3", "h4", "h5", "h6"] },
          "parent_id": {
            "type": ["string", "null"],
            "enum": ["h1", "h2", "h3", "h4", "h5", "h6", null]
          },
          "root_component": {
            "type": "string",
            "description": "本次运行拓扑中的组件键",
            "x-srenautix-dynamic-enum": "components"
          },
          "mechanism": { "type": "string", "maxLength": 600 },
          "mechanism_refs": {
            "type": "array",
            "maxItems": 4,
            "description": "支撑机制的错误样例卡",
            "items": { "type": "string", "x-srenautix-dynamic-enum": "sample_refs" }
          },
          "supporting": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string", "x-srenautix-dynamic-enum": "evidence_refs" }
          },
          "refuting": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string", "x-srenautix-dynamic-enum": "evidence_refs" }
          }
        }
      }
    },
    "next_checks": {
      "type": "array",
      "maxItems": 6,
      "description": "对排名前 N 的假设各给出一项区分性检查，由控制器执行",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "type", "template", "args_json", "refutes_if", "purpose"],
        "properties": {
          "hypothesis_id": { "type": "string", "enum": ["h1", "h2", "h3", "h4", "h5", "h6"] },
          "type": {
            "type": "string",
            "description": "query：领域包的查询模板；tool：只读工具",
            "enum": ["query", "tool"]
          },
          "template": {
            "type": "string",
            "description": "查询模板 <pack>/<id> 或只读工具名",
            "x-srenautix-dynamic-enum": "check_templates"
          },
          "args_json": {
            "type": "string",
            "description": "参数的 JSON 文本，按模板或工具的参数 schema 校验",
            "maxLength": 2000
          },
          "refutes_if": {
            "type": "string",
            "description": "什么样的结果能推翻这个假设",
            "maxLength": 300
          },
          "purpose": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
