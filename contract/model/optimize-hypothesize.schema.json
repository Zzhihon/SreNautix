{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srenautix.io/contract/model/optimize-hypothesize.schema.json",
  "title": "OptimizeHypothesizeOutput",
  "description": "主动优化 hypothesize 步骤的模型输出（ADR 0146 §2.3）。为每个候选发现提出机制假设，机制点明预示的症状；同一发现上的假设互为竞争假设。遵守可移植 schema 子集（DESIGN §8.2）。x-srenautix-dynamic-enum 标出的字段在每次运行时由 worker 替换为本次运行中存在的取值：发现只能是进入分析的候选，检查只能是本次运行的查询模板与只读工具，模型不写任何查询语句",
  "x-srenautix-portable": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["hypotheses", "next_checks"],
  "properties": {
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "description": "按发现分组的假设，用 parent_id 表示同一发现上的细化",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parent_id", "finding", "mechanism", "symptoms", "supporting", "refuting"],
        "properties": {
          "id": { "type": "string", "enum": ["h1", "h2", "h3", "h4", "h5", "h6", "h7", "h8", "h9"] },
          "parent_id": {
            "type": ["string", "null"],
            "enum": ["h1", "h2", "h3", "h4", "h5", "h6", "h7", "h8", "h9", null]
          },
          "finding": {
            "type": "string",
            "description": "假设解释的候选发现（发现指纹）",
            "x-srenautix-dynamic-enum": "findings"
          },
          "mechanism": { "type": "string", "maxLength": 600 },
          "symptoms": {
            "type": "array",
            "maxItems": 4,
            "description": "机制预示的症状类型",
            "items": {
              "type": "string",
              "enum": [
                "seq_scan",
                "index",
                "temp_spill",
                "lock_wait",
                "io_read",
                "connection_pool",
                "cache_miss",
                "polling",
                "n_plus_one",
                "payload_size",
                "overprovision",
                "cpu",
                "memory",
                "connections",
                "storage",
                "network",
                "service"
              ]
            }
          },
          "supporting": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string", "x-srenautix-dynamic-enum": "evidence_refs" }
          },
          "refuting": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string", "x-srenautix-dynamic-enum": "evidence_refs" }
          }
        }
      }
    },
    "next_checks": {
      "type": "array",
      "maxItems": 6,
      "description": "为待检验的假设各给出一项区分性检查，由控制器执行；只能选本次运行的查询模板或只读工具，参数按其 schema 校验",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "type", "template", "args_json", "refutes_if", "purpose"],
        "properties": {
          "hypothesis_id": { "type": "string", "enum": ["h1", "h2", "h3", "h4", "h5", "h6", "h7", "h8", "h9"] },
          "type": {
            "type": "string",
            "description": "query：领域包的查询模板；tool：只读工具",
            "enum": ["query", "tool"]
          },
          "template": {
            "type": "string",
            "description": "查询模板 <pack>/<id> 或只读工具名",
            "x-srenautix-dynamic-enum": "check_templates"
          },
          "args_json": {
            "type": "string",
            "description": "参数的 JSON 文本，按模板或工具的参数 schema 校验",
            "maxLength": 2000
          },
          "refutes_if": { "type": "string", "maxLength": 300 },
          "purpose": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
