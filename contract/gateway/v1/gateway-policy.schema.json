{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srenautix.io/contract/gateway/v1/gateway-policy.schema.json",
  "title": "GatewayPolicy",
  "description": "gateway 策略，来自 Git，经 ConfigMap 挂载（DESIGN §2.1）。只能启用目录中的动作；准入策略与 RBAC 按同一份策略生成。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cluster", "actions", "approvers"],
  "properties": {
    "version": {"const": 1},
    "cluster": {
      "description": "本集群的 cluster_id，必须与断言的 cluster 相同。",
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "actions": {
      "description": "启用的动作。未列出的动作不生成 RBAC 与准入策略，工单直接被拒绝。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
          "namespaces": {
            "description": "允许的目标命名空间；命名空间级动作必填，集群级动作（节点）不填。",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"}
          },
          "auto_execution": {
            "description": "自动执行只允许用于目录中 auto_execution=allowed 的动作，否则策略加载失败（不变量 7）。",
            "type": "object",
            "additionalProperties": false,
            "required": ["rules"],
            "properties": {
              "rules": {
                "description": "允许自动批准的规则名；断言 approver_principal 为 auto:<规则名>。",
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"}
              },
              "namespaces": {
                "description": "自动执行的命名空间，必须是 namespaces 的子集；命名空间级动作必填，集群级动作不填。",
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"}
              }
            }
          }
        }
      }
    },
    "max_auto_executions_per_hour": {"type": "integer", "minimum": 0, "maximum": 1000, "default": 6},
    "self_dependencies": {
      "description": "SreNautix 自己的依赖集合（DESIGN §9.1 自我保护）。目标落在其中时一律按 irreversible 加 H 档处理，并且不自动执行。gateway 所在节点自动计入。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespaces": {"type": "array", "items": {"type": "string"}},
        "nodes": {"type": "array", "items": {"type": "string"}},
        "pg_clusters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "name"],
            "properties": {"namespace": {"type": "string"}, "name": {"type": "string"}}
          }
        }
      }
    },
    "approvers": {
      "description": "审批人的作用域（DESIGN §13 approver 角色）。gateway 按目标所在的命名空间核对。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principal", "namespaces", "max_tier"],
        "properties": {
          "principal": {"type": "string", "minLength": 1},
          "namespaces": {
            "description": "\"*\" 表示全部命名空间（含集群级目标）。",
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "max_tier": {"type": "string", "enum": ["L", "H"]}
        }
      }
    },
    "workflow_templates": {
      "description": "workflow_submit 的模板白名单：名称、sha256(JCS(WorkflowTemplate.spec)) 与 ServiceAccount 都必须一致。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "name", "sha256", "service_account", "parameters"],
        "properties": {
          "namespace": {"type": "string"},
          "name": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "service_account": {"type": "string"},
          "parameters": {
            "description": "参数名到约束；提交的参数必须恰好是这些名称。",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enum": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "pattern": {"type": "string"},
                "max_length": {"type": "integer", "minimum": 1, "maximum": 4096}
              }
            }
          }
        }
      }
    },
    "gitops": {
      "description": "gitops_pr 的仓库、路径白名单与补偿控制（ADR 0025）。",
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories"],
      "properties": {
        "max_prs_per_hour": {
          "description": "每个仓库每小时最多开出的 PR 数（按进入 executing 的时间计），超出的工单以 gitops_rate_limited 拒绝。默认 2。",
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "main_watchdog": {
          "description": "定期检查 base 分支上的提交：由机器人身份直接写入、或由机器人合并的提交为非人工提交，回看窗口内存在时条件 GitMainWatchdog 为 False，gitops_pr 停止推送。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interval": {"description": "检查间隔，Go duration，1s 到 1h，默认 5m。", "type": "string"},
            "lookback": {"description": "回看窗口，Go duration，1h 到 168h，默认 24h。", "type": "string"},
            "allowed_bots": {
              "description": "允许直接写入 base 的机器人账号（例如 renovate[bot]）；gateway 自己的 App 不能列在这里。",
              "type": "array",
              "items": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,39}(\\[bot\\])?$"}
            }
          }
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "base", "paths"],
            "properties": {
              "repository": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$"},
              "base": {"type": "string", "minLength": 1},
              "paths": {
                "description": "允许修改的路径：以 / 结尾的目录前缀、完整路径，或含 * ? [ 的模式（path.Match 语义，* 不跨越 /）。",
                "type": "array",
                "minItems": 1,
                "items": {"type": "string"}
              },
              "reviewers": {
                "description": "开出 PR 后请求审阅的 GitHub 账号；工单参数中的 reviewers 必须是它的子集。",
                "type": "array",
                "maxItems": 10,
                "items": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$"}
              },
              "compensating_controls": {
                "description": "base 分支没有分支保护时，经批准以补偿控制代替（不变量 12，ADR 0025）：只推送 srenautix/ 分支并在推送前后核对 base、从不合并、每次推送与开 PR 写入审计链、按小时限速、main watchdog。这一项记录批准人与依据，没有它时 base 必须有分支保护。",
                "type": "object",
                "additionalProperties": false,
                "required": ["approved_by", "approved_at", "reference"],
                "properties": {
                  "approved_by": {"type": "string", "minLength": 1},
                  "approved_at": {"type": "string", "format": "date"},
                  "reference": {"description": "批准的出处（issue、章程、ADR 链接）。", "type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
