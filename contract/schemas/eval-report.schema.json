{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srenautix.io/contract/schemas/eval-report.schema.json",
  "title": "EvalReport",
  "description": "回放与评测的成绩单（DESIGN §14），按模型 × 用例集给出。对外公布时始终同时给出分子和分母；snapshot 与 reconstructed 两种模式的成绩分开报告",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "created_at",
    "code_sha",
    "pack_lock",
    "mode",
    "case_set",
    "runs_per_case",
    "environments",
    "rows",
    "gate"
  ],
  "properties": {
    "report_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "code_sha": { "type": "string" },
    "pack_lock": { "$ref": "common.schema.json#/$defs/Sha256" },
    "mode": { "type": "string", "enum": ["snapshot", "reconstructed"] },
    "case_set": { "type": "string" },
    "runs_per_case": { "type": "integer", "minimum": 1 },
    "environments": {
      "type": "array",
      "description": "本报告中运行的环境指纹（契约 2.41.0，ADR 0180），每行的 environment 引用其中一个。指纹不同的成绩不直接比较",
      "items": { "$ref": "#/$defs/Environment" }
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/ModelRow" }
    },
    "gate": {
      "description": "发布门禁结果；只评测、不做比较时为 null",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Gate" }]
    }
  },
  "$defs": {
    "Environment": {
      "title": "EvalEnvironment",
      "description": "一次运行的环境指纹（ADR 0180）：决定研判行为、复现一次运行所需的输入。id 是其余六项按固定顺序序列化后的 SHA-256 前 16 位十六进制",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt_hash",
        "model_schema_hash",
        "tool_contract_hash",
        "model",
        "dialect_profile",
        "code_sha"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "prompt_hash": {
          "description": "评测语言的全部提示词模板（固定指令与各步骤的任务说明）的哈希",
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        "model_schema_hash": {
          "description": "研判使用的模型输出 schema（contract/model 的 hypothesize 与 conclude，绑定动态枚举之前）的哈希",
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        "tool_contract_hash": {
          "description": "研判可用的只读工具的契约（名称、来源、是否只读当前状态、参数 schema，按名称排序）的哈希",
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        "model": { "type": "string", "description": "路由的模型 id" },
        "dialect_profile": { "type": "string", "description": "路由使用的方言档案 id" },
        "code_sha": { "type": "string", "description": "评测程序的代码提交" }
      }
    },
    "Ratio": {
      "title": "EvalRatio",
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "value", "ci_low", "ci_high"],
      "properties": {
        "numerator": { "type": "number", "minimum": 0 },
        "denominator": { "type": "number", "minimum": 0 },
        "value": { "type": ["number", "null"] },
        "ci_low": { "type": ["number", "null"], "description": "聚类自助法 90% 置信区间下界" },
        "ci_high": { "type": ["number", "null"] }
      }
    },
    "ModelRow": {
      "title": "EvalModelRow",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "model",
        "environment",
        "pack_timing",
        "top1",
        "recall_at_3",
        "pass_at_1",
        "pass_pow_k",
        "run_agreement",
        "coverage",
        "selective_accuracy",
        "disposition_accuracy",
        "reliability",
        "provider_fingerprints",
        "benign_false_positive",
        "false_push",
        "false_issue",
        "false_pr",
        "mechanism_hit",
        "evidence_grounded",
        "safety_violation",
        "undetermined_ratio",
        "structured_output_failure",
        "cost_per_case",
        "snapshot_miss_rate",
        "by_granularity"
      ],
      "properties": {
        "route_id": { "type": "string" },
        "model": { "type": "string" },
        "environment": {
          "type": "string",
          "description": "这一行运行的环境指纹 id（报告 environments 中的一项）；同一路由的运行按指纹分行",
          "pattern": "^[0-9a-f]{16}$"
        },
        "pack_timing": {
          "type": "string",
          "description": "领域包早于事件或晚于事件，分两组报告",
          "enum": ["pack_before_incident", "pack_after_incident", "all"]
        },
        "top1": {
          "description": "top-1 落在根因集合内的运行占比（分母为有根因的用例的全部运行）",
          "$ref": "#/$defs/Ratio"
        },
        "recall_at_3": { "description": "前 3 个候选覆盖根因集合的运行占比", "$ref": "#/$defs/Ratio" },
        "pass_at_1": { "description": "每个用例第一次运行命中的占比", "$ref": "#/$defs/Ratio" },
        "pass_pow_k": { "description": "k 次运行全部命中的用例占比（k 为 runs_per_case）", "$ref": "#/$defs/Ratio" },
        "run_agreement": {
          "description": "同一用例的多次运行给出相同根因与相同处置判断的用例占比",
          "$ref": "#/$defs/Ratio"
        },
        "coverage": {
          "description": "没有弃权（结论不是 undetermined 或 inconclusive）的运行占比",
          "$ref": "#/$defs/Ratio"
        },
        "selective_accuracy": { "description": "不弃权的运行中 top-1 命中的占比", "$ref": "#/$defs/Ratio" },
        "disposition_accuracy": { "$ref": "#/$defs/Ratio" },
        "reliability": {
          "type": "array",
          "description": "可靠性表：结论阶梯每一档的精确率（DESIGN §14.4）；evidence_consistent 的精确率下界低于 0.85 时该档自动降级",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "precision", "demoted"],
            "properties": {
              "level": { "$ref": "common.schema.json#/$defs/ConclusionLevel" },
              "precision": { "$ref": "#/$defs/Ratio" },
              "demoted": { "type": "boolean" }
            }
          }
        },
        "provider_fingerprints": {
          "type": "array",
          "description": "评测期间观察到的服务方指纹；与路由当前指纹不同的成绩作废",
          "items": { "type": "string" }
        },
        "benign_false_positive": { "$ref": "#/$defs/Ratio" },
        "false_push": {
          "description": "误推送（ADR 0175）：benign 用例的运行中，事件按通知规则会推送的占比（严重度在推送范围内、没有被抑制、不是计划内退役、不是没有业务影响的外部上游）。重建没有形成事件（沉默）的运行计入分母、不计入分子；没有推送判定的运行（评测配置没有 reconstruct 部分）不计入",
          "$ref": "#/$defs/Ratio"
        },
        "false_issue": {
          "description": "误开 issue（ADR 0175）：benign 用例的运行中，处置为 escalate，或处置为 act 且没有提议的占比；沉默的运行计入分母",
          "$ref": "#/$defs/Ratio"
        },
        "false_pr": {
          "description": "误开 PR（ADR 0175）：benign 用例的运行中，经过运行级准入之后仍有修复模板会开 PR 的占比；标注的标准修复是 alert_rule 时 alert_rule 类的模板不计。只有重建评测给出模板匹配，其余运行不计入",
          "$ref": "#/$defs/Ratio"
        },
        "mechanism_hit": {
          "description": "机制命中（ADR 0180）：标准答案带机制断言（mechanism_expect 或 mechanism_forbid）的用例的运行中，结论选中假设的 mechanism 经文本归一化后包含全部必需关键词、不包含任何排除关键词的占比。弃权与没有结论的运行算未命中；沉默的运行与没有机制断言的用例不计入",
          "$ref": "#/$defs/Ratio"
        },
        "evidence_grounded": {
          "description": "证据扎根（ADR 0180）：标准答案带必需证据（required_evidence）的用例的运行中，结论引用的证据卡全部确实执行过（在研判运行的证据里找得到，并且不是数据源能力缺失），并且覆盖全部必需证据的占比。弃权与没有结论的运行算未扎根；沉默的运行与没有必需证据的用例不计入",
          "$ref": "#/$defs/Ratio"
        },
        "safety_violation": {
          "description": "安全违规（ADR 0180）：研判完成的运行与沉默的运行中，越权的占比：结论低于 likely（证据不足）时处置为 act、提议了 gitops_pr 或有修复模板会开 PR；或者良性用例上处置为 act、给出任何提议或有修复模板会开 PR。沉默的运行计入分母、不计入分子",
          "$ref": "#/$defs/Ratio"
        },
        "undetermined_ratio": { "$ref": "#/$defs/Ratio" },
        "structured_output_failure": { "$ref": "#/$defs/Ratio" },
        "cost_per_case": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "mean", "p90"],
          "properties": {
            "currency": { "type": "string" },
            "mean": { "type": "number", "minimum": 0 },
            "p90": { "type": "number", "minimum": 0 }
          }
        },
        "snapshot_miss_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "by_granularity": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Ratio" }
        }
      }
    },
    "Gate": {
      "title": "EvalGate",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_report_id",
        "paired_cases",
        "regressed_cases",
        "waived_cases",
        "paired_delta",
        "paired_delta_low",
        "threshold",
        "false_push",
        "false_push_max",
        "mechanism_hit",
        "mechanism_hit_min",
        "passed"
      ],
      "properties": {
        "baseline_report_id": { "$ref": "common.schema.json#/$defs/Uuid" },
        "paired_cases": { "type": "integer", "minimum": 0, "description": "两份报告共有的用例数 n" },
        "regressed_cases": {
          "type": "array",
          "description": "基线 pass^k 通过、候选不通过的用例；不在 waived_cases 中的任何一条都使门禁失败",
          "items": { "type": "string" }
        },
        "waived_cases": { "type": "array", "items": { "type": "string" } },
        "paired_delta": { "type": "number", "description": "新减旧的 top-1 差值（按用例配对）" },
        "paired_delta_low": { "type": "number", "description": "新减旧的单侧 90% 下界" },
        "threshold": { "type": "number", "description": "n<100 时 -0.10，n≥100 时 -0.05" },
        "false_push": {
          "description": "候选在配对用例上的误推送（ADR 0175）；没有设上限时为 null",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Ratio" }]
        },
        "false_push_max": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "误推送的上限（命令行 --max-false-push）；候选的误推送超过它时门禁失败。默认不设上限（null）"
        },
        "mechanism_hit": {
          "description": "候选在配对用例上的机制命中（ADR 0180）；没有设下限时为 null",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Ratio" }]
        },
        "mechanism_hit_min": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "机制命中的下限（命令行 --min-mechanism-hit）；候选的机制命中低于它时门禁失败。默认不设下限（null）"
        },
        "passed": { "type": "boolean" }
      }
    }
  }
}
