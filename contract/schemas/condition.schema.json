{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srenautix.io/contract/schemas/condition.schema.json",
  "title": "Condition",
  "description": "带类型的状态条件（DESIGN §12.4），驱动每个页面顶部的状态条。每个判定都附带影响它的条件",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "status", "role", "cluster_id", "subject", "reason", "message", "since"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "IngestSilent",
        "WatchdogMissing",
        "DatasourceUnavailable",
        "ModelRouteBreakerOpen",
        "AdmissionSelfTestFailed",
        "PackLoadFailed",
        "BudgetCutoffHigh",
        "ChannelDeliveryFailed",
        "NotifyAbandoned",
        "AuditExportLagging",
        "ClockSkew",
        "StateStoreDegraded",
        "Restored",
        "Frozen",
        "StormMode",
        "InformersFresh",
        "TunnelConnected",
        "QueryManifest",
        "Datasource",
        "AlertReconcile"
      ],
      "description": "server、worker 等角色的条件；InformersFresh、TunnelConnected、QueryManifest、Datasource、AlertReconcile 由分支 reader 的心跳转来（role 为 reader，见 gateway/v1/reader.openapi.yaml 的 ReaderCondition），ClockSkew 两边都有。NotifyAbandoned（契约 2.39.0，ADR 0173）：最近 1 小时内某个渠道放弃投递了消息内容，subject 为渠道。控制台必须容忍以后新增的类型"
    },
    "status": {
      "type": "string",
      "description": "true 表示该问题正在发生",
      "enum": ["true", "false"]
    },
    "role": { "type": "string", "enum": ["server", "worker", "mcp", "reader", "gateway"] },
    "cluster_id": {
      "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/ClusterId" }]
    },
    "subject": {
      "type": ["string", "null"],
      "description": "条件涉及的对象，例如集成实例 id、路由 id、领域包名"
    },
    "reason": { "type": "string" },
    "message": { "type": "string" },
    "since": { "$ref": "common.schema.json#/$defs/Timestamp" }
  }
}
