{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srenautix.io/contract/schemas/incident-export.schema.json",
  "title": "IncidentExport",
  "description": "GET /v1/incidents/export 的 JSON 结果（契约 2.49.0，ADR 0186）：时间窗内按条件筛出的事件明细、按系列的汇总（group=series 时）、每个集群的 Kubernetes Warning 查询状态与疑似同一根因的分组。告警、注解、模型与证据卡给出的文字照原样给出，与 GET /v1/incidents/{incident_ref} 相同",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "window",
    "filters",
    "group",
    "grouping",
    "incidents",
    "series",
    "kube_warnings",
    "suppressed_count",
    "complete",
    "truncated",
    "next_cursor"
  ],
  "properties": {
    "generated_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "window": { "$ref": "common.schema.json#/$defs/TimeWindow", "description": "请求的时间窗；与它有重叠的事件被导出" },
    "filters": { "$ref": "#/$defs/Filters" },
    "group": { "$ref": "#/$defs/GroupBy" },
    "grouping": { "$ref": "#/$defs/GroupingParams" },
    "incidents": {
      "type": "array",
      "description": "事件明细，按 first_firing_at 从新到旧、同一时刻按 incident_id 从大到小",
      "items": { "$ref": "#/$defs/Incident" }
    },
    "series": {
      "description": "group=series 时为按系列的汇总，按最近一次触发从新到旧；group=incident 时为 null",
      "oneOf": [{ "type": "null" }, { "type": "array", "items": { "$ref": "#/$defs/Series" } }]
    },
    "kube_warnings": {
      "type": "array",
      "description": "每个导出了事件的集群一项，按 cluster_id 排序",
      "items": { "$ref": "#/$defs/ClusterKubeWarnings" }
    },
    "suppressed_count": {
      "type": "integer",
      "minimum": 0,
      "description": "suppressed=false 时，本次导出覆盖的范围内（到最后一个导出的事件为止）被抑制、没有导出的事件数；suppressed=true 时为 0"
    },
    "complete": { "type": "boolean", "description": "全部集群的 Kubernetes Warning 查询都成功且没有截断时为 true" },
    "truncated": {
      "type": "boolean",
      "description": "符合条件的事件多于 limit 时为 true，余下的事件用 next_cursor 继续导出"
    },
    "next_cursor": { "type": ["string", "null"] }
  },
  "$defs": {
    "GroupBy": {
      "title": "IncidentExportGroupBy",
      "description": "incident 只给出事件明细；series 另外按系列汇总",
      "type": "string",
      "enum": ["incident", "series"]
    },
    "Filters": {
      "title": "IncidentExportFilters",
      "description": "实际使用的筛选条件，语义与 GET /v1/incidents 相同",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_id",
        "severity",
        "component",
        "category",
        "exclude_category",
        "exclude_component",
        "suppressed"
      ],
      "properties": {
        "cluster_id": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/ClusterId" }] },
        "severity": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/Severity" }] },
        "component": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/ComponentKey" }] },
        "category": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/IncidentCategory" } },
        "exclude_category": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/AlertCategory" } },
        "exclude_component": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ComponentKey" } },
        "suppressed": { "type": "boolean", "description": "是否导出被抑制的事件" }
      }
    },
    "GroupingParams": {
      "title": "IncidentExportGroupingParams",
      "description": "疑似同一根因分组实际使用的参数（ADR 0185 §5），由查询参数 group_gap、group_before、group_after、group_min_incidents 覆盖默认值。每个分组的 criteria 另外列出它的信号 reason",
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_seconds", "before_seconds", "after_seconds", "min_incidents"],
      "properties": {
        "gap_seconds": { "type": "integer", "minimum": 0 },
        "before_seconds": { "type": "integer", "minimum": 0 },
        "after_seconds": { "type": "integer", "minimum": 0 },
        "min_incidents": { "type": "integer", "minimum": 1 }
      }
    },
    "Incident": {
      "title": "ExportedIncident",
      "description": "导出的一个事件",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_id",
        "cluster_id",
        "label",
        "state",
        "severity",
        "categories",
        "primary_category",
        "alertnames",
        "root",
        "components",
        "first_firing_at",
        "last_firing_at",
        "ended_at",
        "firing_seconds",
        "occurrences",
        "merged_count",
        "reopened_count",
        "series_key",
        "conclusion",
        "evidence",
        "issues",
        "kube_warnings"
      ],
      "properties": {
        "incident_id": { "$ref": "common.schema.json#/$defs/Uuid" },
        "cluster_id": { "$ref": "common.schema.json#/$defs/ClusterId" },
        "label": { "$ref": "incident.schema.json#/$defs/IncidentLabel" },
        "state": { "type": "string", "enum": ["firing", "resolved"] },
        "severity": { "$ref": "common.schema.json#/$defs/Severity" },
        "categories": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/IncidentCategory" } },
        "primary_category": { "$ref": "common.schema.json#/$defs/IncidentCategory" },
        "alertnames": {
          "type": "array",
          "description": "成员告警的告警名，去重排序；离开时仍在触发的成员（转到了别的事件）不算",
          "items": { "type": "string" }
        },
        "root": {
          "type": "object",
          "additionalProperties": false,
          "required": ["component", "entity", "ambiguous"],
          "properties": {
            "component": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/ComponentKey" }] },
            "entity": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/EntityRef" }] },
            "ambiguous": { "type": "boolean" }
          }
        },
        "components": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ComponentKey" } },
        "first_firing_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "last_firing_at": {
          "$ref": "common.schema.json#/$defs/Timestamp",
          "description": "最后一次开始触发的时刻：成员告警 starts_at 的最大值"
        },
        "ended_at": {
          "description": "事件恢复的时刻；仍在触发时为 null",
          "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/Timestamp" }]
        },
        "firing_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "累计触发时长：成员告警触发区间的并集（ADR 0184 的发生）的总长，仍在触发的区间算到 generated_at"
        },
        "occurrences": { "type": "integer", "minimum": 0, "description": "成员告警触发区间合并后的段数，即发生次数" },
        "merged_count": { "type": "integer", "minimum": 0, "description": "合并进本事件的事件数（incident_aliases）" },
        "reopened_count": {
          "type": "integer",
          "minimum": 0,
          "description": "版本原因为 reopened 的版本数（ADR 0132、0184）"
        },
        "series_key": {
          "type": ["string", "null"],
          "description": "事件的系列键（ADR 0184）；之前版本写入的事件与没有根因的事件为 null"
        },
        "conclusion": { "$ref": "#/$defs/Conclusion" },
        "evidence": {
          "type": "array",
          "description": "最新阶段 A 报告里 abnormal 与 undeterminable 的证据卡，abnormal 在前",
          "items": { "$ref": "#/$defs/EvidenceCard" }
        },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/Issue" } },
        "kube_warnings": { "$ref": "kube-warnings.schema.json#/$defs/Summary" }
      }
    },
    "Conclusion": {
      "title": "ExportedConclusion",
      "description": "事件的研判结论：最近一次完成的阶段 B 研判；没有时取最新版本的阶段 A 处置；都没有时 source 为 none",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "disposition",
        "conclusion_level",
        "disposition_reason",
        "run_id",
        "incident_version",
        "at",
        "summary",
        "undetermined"
      ],
      "properties": {
        "source": { "type": "string", "enum": ["research", "stage_a", "none"] },
        "disposition": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/Disposition" }] },
        "conclusion_level": {
          "description": "阶段 B 的结论档位；source 不是 research 时为 null",
          "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/ConclusionLevel" }]
        },
        "disposition_reason": {
          "type": ["string", "null"],
          "description": "source 为 stage_a 时为阶段 A 报告的 disposition_reason，其余为 null"
        },
        "run_id": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/Uuid" }] },
        "incident_version": { "type": ["integer", "null"], "minimum": 1, "description": "结论所针对的事件版本" },
        "at": {
          "description": "研判完成或阶段 A 报告生成的时刻",
          "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/Timestamp" }]
        },
        "summary": { "type": ["string", "null"], "description": "阶段 B 研判的摘要（模型生成）" },
        "undetermined": {
          "description": "处置或结论档位为 undetermined、或者没有任何结论时，给出原因；其余为 null",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Undetermined" }]
        }
      }
    },
    "Undetermined": {
      "title": "ExportedUndetermined",
      "type": "object",
      "additionalProperties": false,
      "required": ["codes", "undetermined_reason"],
      "properties": {
        "codes": {
          "type": "array",
          "description": "登记表中的原因码：研判的停止原因、研判失败的类型、入队跳过的原因，以及事件最近一个有终态记录的版本上 research、stage_a 阶段的终态记录",
          "items": { "$ref": "#/$defs/Reason" }
        },
        "undetermined_reason": {
          "type": ["string", "null"],
          "description": "阶段 B 研判给出的无法判定的原因（模型生成）"
        }
      }
    },
    "Reason": {
      "title": "ExportedReason",
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "code", "level", "text", "detail"],
      "properties": {
        "stage": { "$ref": "reason-codes.schema.json#/$defs/Stage" },
        "code": { "type": "string" },
        "level": { "$ref": "reason-codes.schema.json#/$defs/Level" },
        "text": { "type": "string", "description": "登记表中的中文说明" },
        "detail": { "type": ["string", "null"], "description": "记录带的说明（错误摘要等）" }
      }
    },
    "EvidenceCard": {
      "title": "ExportedEvidenceCard",
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "card_id", "title", "verdict", "reason_kind", "summary"],
      "properties": {
        "ref": { "$ref": "common.schema.json#/$defs/EvidenceRef" },
        "card_id": { "type": "string" },
        "title": { "$ref": "evidence-card.schema.json#/$defs/LocalizedText" },
        "verdict": { "type": "string", "enum": ["abnormal", "undeterminable"] },
        "reason_kind": { "type": "string", "description": "EvidenceResult.reason.kind，例如 no_data（查询没有样本）" },
        "summary": {
          "type": "string",
          "maxLength": 300,
          "description": "一句摘要：主值（有时）加上判定说明的第一句"
        }
      }
    },
    "Issue": {
      "title": "ExportedIssue",
      "description": "事件关联的 GitHub issue（server.github_issues）；同一系列复用的 issue（ADR 0184）reused 为 true",
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "number", "url", "state", "reused"],
      "properties": {
        "repo": { "type": "string", "description": "owner/name" },
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string" },
        "state": { "type": "string", "enum": ["open", "closed"], "description": "closed 表示人已经在 GitHub 上关闭" },
        "reused": { "type": "boolean" }
      }
    },
    "Series": {
      "title": "ExportedSeries",
      "description": "同一系列的事件的汇总：有系列键（ADR 0184）时按系列键，没有时按 告警名集合 + 根因组件",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "key_source",
        "cluster_id",
        "root_component",
        "alertnames",
        "occurrences",
        "firing_seconds",
        "first_firing_at",
        "last_firing_at",
        "ended_at",
        "incident_ids",
        "issues"
      ],
      "properties": {
        "key": { "type": "string" },
        "key_source": {
          "type": "string",
          "enum": ["series_key", "alertnames_root"],
          "description": "series_key：事件的系列键；alertnames_root：事件没有系列键，按 <根因组件>|<告警名,…> 求出"
        },
        "cluster_id": { "$ref": "common.schema.json#/$defs/ClusterId" },
        "root_component": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/ComponentKey" }] },
        "alertnames": { "type": "array", "items": { "type": "string" } },
        "occurrences": {
          "type": "integer",
          "minimum": 1,
          "description": "全部事件的成员告警触发区间合并后的段数"
        },
        "firing_seconds": { "type": "integer", "minimum": 0 },
        "first_firing_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "last_firing_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "ended_at": {
          "description": "最后一个事件恢复的时刻；有事件仍在触发时为 null",
          "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/Timestamp" }]
        },
        "incident_ids": {
          "type": "array",
          "description": "按 first_firing_at 从新到旧",
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "issues": { "type": "array", "description": "按 repo 与 number 去重", "items": { "$ref": "#/$defs/Issue" } }
      }
    },
    "ClusterKubeWarnings": {
      "title": "ExportedClusterKubeWarnings",
      "description": "一个集群的 KubeWarningReport（ADR 0185）去掉 summaries（摘要放在每个事件的 kube_warnings 上）",
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_id", "window", "step_seconds", "complete", "queries", "groups"],
      "properties": {
        "cluster_id": { "$ref": "common.schema.json#/$defs/ClusterId" },
        "window": { "$ref": "common.schema.json#/$defs/TimeWindow" },
        "step_seconds": { "type": "integer", "minimum": 60 },
        "complete": { "type": "boolean" },
        "queries": { "type": "array", "items": { "$ref": "kube-warnings.schema.json#/$defs/Query" } },
        "groups": { "type": "array", "items": { "$ref": "kube-warnings.schema.json#/$defs/Group" } }
      }
    },
    "Record": {
      "title": "IncidentExportRecord",
      "description": "format=ndjson 时的一行。顺序：一行 header，每个事件一行 incident，group=series 时每个系列一行 series，每个集群一行 kube_warnings，最后一行 end",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "generated_at", "window", "filters", "group", "grouping"],
          "properties": {
            "type": { "const": "header" },
            "generated_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
            "window": { "$ref": "common.schema.json#/$defs/TimeWindow" },
            "filters": { "$ref": "#/$defs/Filters" },
            "group": { "$ref": "#/$defs/GroupBy" },
            "grouping": { "$ref": "#/$defs/GroupingParams" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "incident"],
          "properties": { "type": { "const": "incident" }, "incident": { "$ref": "#/$defs/Incident" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "series"],
          "properties": { "type": { "const": "series" }, "series": { "$ref": "#/$defs/Series" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "kube_warnings"],
          "properties": {
            "type": { "const": "kube_warnings" },
            "kube_warnings": { "$ref": "#/$defs/ClusterKubeWarnings" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "incidents", "suppressed_count", "complete", "truncated", "next_cursor"],
          "properties": {
            "type": { "const": "end" },
            "incidents": { "type": "integer", "minimum": 0, "description": "导出的事件数" },
            "suppressed_count": { "type": "integer", "minimum": 0 },
            "complete": { "type": "boolean" },
            "truncated": { "type": "boolean" },
            "next_cursor": { "type": ["string", "null"] }
          }
        }
      ]
    }
  }
}
