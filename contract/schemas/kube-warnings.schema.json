{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srenautix.io/contract/schemas/kube-warnings.schema.json",
  "title": "KubeWarningReport",
  "description": "一次导出里一个集群的 Kubernetes Warning 摘要与疑似同一根因的分组（契约 2.47.0，ADR 0185）。每个事件一条摘要，顺序与请求中的事件相同；分组只在导出时按启发式算出，不进入研判，也不合并事件",
  "type": "object",
  "additionalProperties": false,
  "required": ["cluster_id", "window", "step_seconds", "complete", "queries", "summaries", "groups"],
  "properties": {
    "cluster_id": { "$ref": "common.schema.json#/$defs/ClusterId" },
    "window": {
      "$ref": "common.schema.json#/$defs/TimeWindow",
      "description": "全部事件时间窗的并集范围（终点不晚于计算时刻），查询覆盖这个范围"
    },
    "step_seconds": {
      "type": "integer",
      "minimum": 60,
      "description": "计数的时间分桶宽度；一个分桶与事件时间窗有重叠就计入该事件"
    },
    "complete": {
      "type": "boolean",
      "description": "全部查询都成功且没有截断时为 true"
    },
    "queries": { "type": "array", "items": { "$ref": "#/$defs/Query" } },
    "summaries": { "type": "array", "items": { "$ref": "#/$defs/Summary" } },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/Group" } }
  },
  "$defs": {
    "Source": {
      "title": "KubeWarningSource",
      "description": "计数的来源：events 为 Loki 里采集的 Kubernetes 事件；kube_state_metrics 为 kube-state-metrics 指标",
      "type": "string",
      "enum": ["events", "kube_state_metrics"]
    },
    "Unit": {
      "title": "KubeWarningUnit",
      "description": "计数的单位：occurrences 为发生次数（事件的记录次数、容器因 OOM 重启的次数）；pods 为处于该状态的不同 Pod 数；seconds 为节点处于该状态的累计秒数",
      "type": "string",
      "enum": ["occurrences", "pods", "seconds"]
    },
    "Count": {
      "title": "KubeWarningCount",
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "source", "unit", "count", "memory"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Kubernetes 事件的 reason，例如 Evicted、FailedScheduling、BackOff、OOMKilled、EvictionThresholdMet、NodeHasInsufficientMemory、SystemOOM。kube-state-metrics 的计数使用对应的事件 reason"
        },
        "source": { "$ref": "#/$defs/Source" },
        "unit": { "$ref": "#/$defs/Unit" },
        "count": { "type": "integer", "minimum": 0 },
        "memory": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "count 中消息提到内存的部分（low on resource: memory、Insufficient memory、reclaim memory）；来源不带消息时为 null"
        }
      }
    },
    "Query": {
      "title": "KubeWarningQuery",
      "description": "实际执行的一次聚合查询。每次导出每个集群执行的查询数固定，与事件数无关",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "query", "status", "series", "detail", "duration_ms"],
      "properties": {
        "name": {
          "type": "string",
          "description": "查询名：events（Loki 事件计数）、oom_killed、evicted、unschedulable、crash_loop、memory_pressure（kube-state-metrics）"
        },
        "source": { "$ref": "#/$defs/Source" },
        "query": { "type": "string", "description": "执行的 LogQL 或 PromQL" },
        "status": {
          "type": "string",
          "description": "ok 完整；truncated 序列数超过上限，只保留了按标签排序的前若干条；failed 查询失败或超时，这一来源的计数缺失",
          "enum": ["ok", "truncated", "failed"]
        },
        "series": { "type": "integer", "minimum": 0, "description": "保留的序列数" },
        "detail": { "type": ["string", "null"], "description": "截断或失败的说明" },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "Summary": {
      "title": "KubeWarningSummary",
      "description": "一个事件时间窗内、事件组件的对象与组件所在节点上的 Warning 计数",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_id",
        "window",
        "complete",
        "components",
        "counts",
        "nodes",
        "objects",
        "objects_truncated",
        "scale_targets"
      ],
      "properties": {
        "incident_id": { "$ref": "common.schema.json#/$defs/Uuid" },
        "window": { "$ref": "common.schema.json#/$defs/TimeWindow" },
        "complete": {
          "type": "boolean",
          "description": "与报告的 complete 相同；单独导出一条事件时也能看到计数是否完整"
        },
        "components": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/ComponentKey" },
          "description": "计数所针对的组件（请求中给出的事件组件）"
        },
        "counts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Count" },
          "description": "组件自身以及拓扑中属于它的对象（Pod、ReplicaSet 等）上的计数，按 reason、source、unit 排序"
        },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/Node" },
          "description": "时间窗内组件所在的节点，以及每个节点上（节点对象与该节点上的全部 Pod）的计数，按节点名排序"
        },
        "objects": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/Object" },
          "description": "组件对象的明细，按总计数从高到低，最多 20 个"
        },
        "objects_truncated": { "type": "boolean" },
        "scale_targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/ScaleTarget" },
          "description": "组件中的 HorizontalPodAutoscaler 与它伸缩的工作负载（契约 2.50.0）：counts、nodes、objects 也包含从伸缩对象展开得到的对象与节点。按 hpa、target 排序；组件里没有 HPA 时为空"
        }
      }
    },
    "ScaleTarget": {
      "title": "KubeWarningScaleTarget",
      "description": "HPA 组件展开到的伸缩对象，以及确定这个关系的依据",
      "type": "object",
      "additionalProperties": false,
      "required": ["hpa", "target", "basis"],
      "properties": {
        "hpa": { "$ref": "common.schema.json#/$defs/ComponentKey" },
        "target": {
          "$ref": "common.schema.json#/$defs/ComponentKey",
          "description": "HPA 的 scales 边指向的工作负载（spec.scaleTargetRef）"
        },
        "basis": {
          "type": "string",
          "enum": ["in_window", "last_known"],
          "description": "in_window：拓扑历史在事件时间窗内有这条 scales 边；last_known：时间窗内没有这个 HPA 的 scales 边（例如拓扑来源开始上报 scales 之前的历史），取它最近一次已知的 scales 边，伸缩对象的 Pod 与节点仍按事件时间窗取"
        }
      }
    },
    "Node": {
      "title": "KubeWarningNode",
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "via", "counts"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "via": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["component", "topology", "events"] },
          "description": "确定组件在这个节点上的依据：component 组件本身就是这个节点；topology 拓扑历史里组件的 Pod 在时间窗内运行在这个节点（runs_on）；events 组件对象的事件由这个节点的 kubelet 记录"
        },
        "counts": { "type": "array", "items": { "$ref": "#/$defs/Count" } }
      }
    },
    "Object": {
      "title": "KubeWarningObject",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "namespace", "name", "nodes", "counts"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "namespace": { "type": ["string", "null"] },
        "name": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "计数归属的节点；调度失败等没有节点的计数不出现在这里"
        },
        "counts": { "type": "array", "items": { "$ref": "#/$defs/Count" } }
      }
    },
    "GroupKind": {
      "title": "SuspectedCommonCauseKind",
      "description": "疑似同一根因的种类。node_memory_eviction：节点内存不足，kubelet 驱逐 Pod 或节点进入内存压力。以后的契约版本会增加取值，使用方必须容忍未知的种类",
      "type": "string",
      "enum": ["node_memory_eviction"]
    },
    "Group": {
      "title": "SuspectedCommonCauseGroup",
      "description": "疑似由同一根因引起的一组事件：事件时间窗与节点信号的时间段（按 criteria 放宽）重叠、事件组件在这些节点上。分组是启发式的疑似结论，依据全部列出",
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "kind", "suspected", "window", "criteria", "nodes", "incidents", "alertnames"],
      "properties": {
        "group_id": {
          "$ref": "common.schema.json#/$defs/Sha256",
          "description": "sha256:<sha256(JCS([cluster_id, kind, 各节点信号时间段]))>，同样的信号得到同样的 id"
        },
        "kind": { "$ref": "#/$defs/GroupKind" },
        "suspected": { "const": true },
        "window": { "$ref": "common.schema.json#/$defs/TimeWindow", "description": "全部节点信号时间段的范围" },
        "criteria": { "$ref": "#/$defs/Criteria" },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/GroupNode" } },
        "incidents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/GroupIncident" } },
        "alertnames": {
          "type": "array",
          "items": { "type": "string" },
          "description": "组内全部事件的成员告警名，排序去重"
        }
      }
    },
    "Criteria": {
      "title": "SuspectedCommonCauseCriteria",
      "description": "分组使用的判据",
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_reasons", "gap_seconds", "before_seconds", "after_seconds", "min_incidents"],
      "properties": {
        "signal_reasons": {
          "type": "array",
          "items": { "type": "string" },
          "description": "算作节点信号的 reason；Evicted、EvictionThresholdMet 只在消息提到内存时算"
        },
        "gap_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "同一节点上相邻信号的间隔不超过它时并为一个时间段"
        },
        "before_seconds": { "type": "integer", "minimum": 0, "description": "事件可以早于信号时间段开始的时长" },
        "after_seconds": { "type": "integer", "minimum": 0, "description": "事件可以晚于信号时间段结束的时长" },
        "min_incidents": { "type": "integer", "minimum": 1, "description": "成组需要的最少事件数" }
      }
    },
    "GroupNode": {
      "title": "SuspectedCommonCauseNode",
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "signal_windows", "counts"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "signal_windows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/TimeWindow" },
          "description": "这个节点上参与本组的信号时间段，按开始时间排序"
        },
        "counts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Count" },
          "description": "信号时间段内这个节点上（节点对象与其上的全部 Pod）的各原因计数"
        }
      }
    },
    "GroupIncident": {
      "title": "SuspectedCommonCauseIncident",
      "type": "object",
      "additionalProperties": false,
      "required": ["incident_id", "window", "alertnames", "nodes", "overlap_seconds", "counts"],
      "properties": {
        "incident_id": { "$ref": "common.schema.json#/$defs/Uuid" },
        "window": { "$ref": "common.schema.json#/$defs/TimeWindow" },
        "alertnames": { "type": "array", "items": { "type": "string" } },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "有本组信号、并且组件在事件时间窗或信号时间段内所在的节点"
        },
        "overlap_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "事件时间窗与这些节点的信号时间段重叠的总秒数（时间段先取并集）；事件开始于信号结束之后、仍在 after_seconds 以内时为 0"
        },
        "counts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Count" },
          "description": "事件时间窗内组件对象上的计数（与摘要的 counts 相同），例如调度失败中提到内存的次数"
        }
      }
    }
  }
}
