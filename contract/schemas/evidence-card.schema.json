{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srenautix.io/contract/schemas/evidence-card.schema.json",
  "title": "EvidenceCardDefinition",
  "description": "证据卡定义（DESIGN §6.1），写在领域包 chains.yaml 的证据链中。卡片只包含数据：信号引用、时间窗口、params、CEL 判定、声明式展示和链接。CEL 只在 TypeScript 运行时求值，求值成本有上限",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "refs", "judge", "egress"],
  "properties": {
    "id": {
      "type": "string",
      "description": "证据链内唯一；全局 id 为 <pack>/<chain>/<id>",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "title": { "$ref": "#/$defs/LocalizedText" },
    "note": {
      "description": "这张卡展示什么、怎么读",
      "$ref": "#/$defs/LocalizedText"
    },
    "applies_to": {
      "type": "object",
      "description": "卡片对哪些实体执行；不填时对证据链所属组件执行",
      "additionalProperties": false,
      "properties": {
        "kinds": { "type": "array", "items": { "type": "string" } },
        "component_types": { "type": "array", "items": { "type": "string" } }
      }
    },
    "window": { "$ref": "#/$defs/Window" },
    "params": {
      "type": "object",
      "description": "可由用户层覆盖的参数及默认值，在查询模板中写作 $params.<名字>，在 CEL 中写作 params.<名字>",
      "additionalProperties": { "type": ["number", "string", "boolean"] }
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/SignalRef" }
    },
    "judge": { "$ref": "#/$defs/Judge" },
    "display": { "$ref": "#/$defs/Display" },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/Link" }
    },
    "egress": { "$ref": "common.schema.json#/$defs/Egress" },
    "probe": {
      "type": "boolean",
      "default": false,
      "description": "沉默根因探测卡：症状存在但没有指向原因的告警时，对上游组件执行，结果异常的组件加入根因候选"
    },
    "baseline": {
      "type": "boolean",
      "default": true,
      "description": "判为异常时是否与事件之前的时段比较（证据基线，ADR 0153）。false 用于描述这次故障是什么类型的卡（失败按错误类型、按模型的分布，与同类对象的同期对照）：它们的结论是这次故障本身的属性，类型在过去出现过不说明这次不是这个类型，不取基线样本，异常时照常作为支持证据（契约 2.35.0，ADR 0164）"
    },
    "impact": {
      "type": "boolean",
      "default": false,
      "description": "影响类卡片：衡量用户可见的影响（错误率、可用性、业务量）。异常时它的标题与值写进通知的影响范围"
    },
    "category": {
      "type": "string",
      "description": "业务关键信号的类别（ADR 0148）：storage 存储（PVC 与卷容量、IO、对象存储）、memory 内存（使用占 limit、OOM）、cpu CPU（使用、节流、HPA 饱和）、traffic 流量负载（请求量、错误率、延迟）、blocking 阻塞（队列积压、锁等待、Pending 与 Init 卡住、PDB 阻塞驱逐、rollout 停滞）。异常或接近阈值时，卡片进入事件消息的“业务关键信号”段；不填时按证据链与卡片名推断",
      "enum": ["storage", "memory", "cpu", "traffic", "blocking"]
    },
    "requires": {
      "type": "array",
      "description": "卡片需要的集成能力，例如 metrics.query_range、logs.match。能力不可用时卡片显示 capability_missing",
      "items": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+$" }
    },
    "samples": { "$ref": "#/$defs/Samples" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "description": "作为阶段 B 区分性检查执行时的说明与可覆盖参数（ADR 0116）。没有它时卡片仍可作为检查，参数为全部 params 与 window_before、window_after，类型取默认值；有它时 params 的取值范围按 args 约束。window_before、window_after 总是由运行时提供，不在 args 中声明",
      "properties": {
        "description": {
          "$ref": "#/$defs/LocalizedText",
          "description": "这张卡作为检查时判断什么、结果怎样区分假设"
        },
        "args": {
          "type": "object",
          "description": "可覆盖参数的 JSON Schema（type: object、additionalProperties: false）：每个属性都是卡片 params 的键，带 description；字符串用 enum 或 pattern 限定，数字有 minimum 与 maximum，卡片的默认值满足它",
          "required": ["type", "properties"],
          "properties": {
            "type": { "const": "object" },
            "additionalProperties": { "const": false },
            "properties": { "type": "object" }
          }
        }
      }
    }
  },
  "$defs": {
    "LocalizedText": {
      "title": "LocalizedText",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "zh-CN": { "type": "string" },
        "en": { "type": "string" }
      }
    },
    "Window": {
      "title": "CardWindow",
      "description": "相对事件锚点（首次触发时间）的窗口",
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "$ref": "common.schema.json#/$defs/Duration" },
        "after": { "$ref": "common.schema.json#/$defs/Duration" }
      }
    },
    "SignalRef": {
      "title": "CardSignalRef",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "signal", "mode"],
      "properties": {
        "name": {
          "type": "string",
          "description": "在 CEL 中引用的名字",
          "pattern": "^[a-z][a-zA-Z0-9_]*$"
        },
        "signal": {
          "type": "string",
          "description": "signals.yaml 中的信号 <pack>/<signal id>；同包内可省略 <pack>/"
        },
        "mode": {
          "type": "string",
          "description": "dbstats 读取 dbstats 信号（契约 2.28.0）：每行一条序列，点为采样时刻",
          "enum": ["range", "instant", "logs", "traces", "dbstats"]
        },
        "params": {
          "type": "object",
          "additionalProperties": { "type": ["number", "string", "boolean"] }
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "empty_is": {
          "type": "string",
          "description": "no_data：没有序列视为缺数据，引用它的规则不可求值，卡片不能判为正常；normal：过滤型查询（例如 ... > 0），没有序列表示没有命中。每张卡至少有一个 no_data 引用（加载时校验）",
          "enum": ["no_data", "normal"],
          "default": "no_data"
        }
      }
    },
    "Binding": {
      "title": "CardBinding",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cel"],
      "properties": {
        "name": {
          "type": "string",
          "description": "保留名 anomaly_started_at（unix 秒）用于填写 EvidenceResult 的同名字段",
          "pattern": "^[a-z][a-zA-Z0-9_]*$"
        },
        "cel": { "type": "string", "minLength": 1 }
      }
    },
    "Judge": {
      "title": "CardJudge",
      "description": "先求 undeterminable_if，命中即为无法判定；再按顺序求 abnormal_if，命中第一条即为异常；都不命中为正常。表达式出错时为无法判定。没有任何样本永远不是正常",
      "type": "object",
      "additionalProperties": false,
      "required": ["abnormal_if"],
      "properties": {
        "let": {
          "type": "array",
          "description": "按顺序求值的绑定；结果可在 undeterminable_if、abnormal_if、display.value、display.threshold、表格列和 say 的 ICU 参数中引用",
          "items": { "$ref": "#/$defs/Binding" }
        },
        "abnormal_if": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Rule" }
        },
        "undeterminable_if": {
          "type": "array",
          "items": { "$ref": "#/$defs/Rule" }
        }
      }
    },
    "Rule": {
      "title": "CardRule",
      "type": "object",
      "additionalProperties": false,
      "required": ["cel", "say"],
      "properties": {
        "cel": { "type": "string", "minLength": 1 },
        "say": {
          "description": "命中时的理由，ICU MessageFormat，可引用 CEL 变量",
          "$ref": "#/$defs/LocalizedText"
        },
        "normal_say": {
          "description": "求值为 false 时的说明（例如“连接池峰值 {poolPeak, number, percent}，未超过 95%”），ICU MessageFormat，可引用的参数与 say 相同",
          "$ref": "#/$defs/LocalizedText"
        }
      }
    },
    "Display": {
      "title": "CardDisplay",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "description": "主值的 CEL 表达式" },
        "unit": {
          "type": "string",
          "enum": ["none", "percent", "ratio", "bytes", "seconds", "count", "per_second"]
        },
        "threshold": { "type": "string", "description": "图上阈值线的 CEL 表达式" },
        "baseline": {
          "type": "string",
          "description": "对比基线的 CEL 表达式（例如前一天的中位数），结果写入 EvidenceResult.baseline"
        },
        "table": { "$ref": "#/$defs/TableTemplate" }
      }
    },
    "TableTemplate": {
      "title": "CardTableTemplate",
      "type": "object",
      "additionalProperties": false,
      "required": ["rows_from", "columns"],
      "properties": {
        "rows_from": { "type": "string", "description": "每个序列或日志行一行的引用名" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["header", "cel"],
            "properties": {
              "header": { "$ref": "#/$defs/LocalizedText" },
              "cel": { "type": "string" },
              "unit": { "type": "string" }
            }
          }
        },
        "sort_by": { "type": "string" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 8 }
      }
    },
    "Samples": {
      "title": "CardSamples",
      "description": "错误样例（契约 2.42.0，ADR 0177）：把 ref 指向的日志引用取回的日志行按 dimensions 聚合成维度组合，按 classes 归入错误类别，每个类别取少量原始样例；样例与维度值先脱敏再截断。声明它的卡 egress 必须是 redact 或 never（加载时校验），样例出境的数据类别为 logs。结果写在 EvidenceResult.samples，没有声明 display.table 时维度组合同时写成卡片的表格",
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "dimensions"],
      "properties": {
        "ref": {
          "type": "string",
          "description": "卡片中 mode 为 logs 的引用名。计数取自这个引用返回的日志行，行数达到引用的 limit 时计数是下限",
          "pattern": "^[a-z][a-zA-Z0-9_]*$"
        },
        "dimensions": {
          "type": "array",
          "description": "聚合维度，按声明顺序组成维度组合，例如依赖方、模型、内部错误码、依赖方返回的状态码",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/SamplesDimension" }
        },
        "classes": {
          "type": "array",
          "description": "错误类别，按声明顺序取第一个命中的类别；一个都没有命中的行归入 other",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/SamplesClass" }
        },
        "per_class": {
          "type": "integer",
          "description": "每个类别最多取几条样例；同一类别内先轮流取不同的维度组合，再按时间从新到旧",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "max_chars": {
          "type": "integer",
          "description": "每条样例脱敏之后保留的最多字符数，超出部分截断",
          "minimum": 80,
          "maximum": 2000,
          "default": 300
        },
        "max_groups": {
          "type": "integer",
          "description": "结果里保留的维度组合数，按行数从多到少；其余的只计入 groups_omitted",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        }
      }
    },
    "SamplesDimension": {
      "title": "CardSamplesDimension",
      "description": "一个聚合维度，label 与 regex 二选一（加载时校验）",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "title": { "$ref": "#/$defs/LocalizedText" },
        "label": {
          "type": "string",
          "description": "日志行的标签名：日志流的标签，或 LogQL 解析器（例如 | json、| logfmt）提取出的标签"
        },
        "regex": {
          "type": "string",
          "description": "在日志行上匹配的正则（ECMAScript 语法），取第一个捕获组；不匹配时这一维为 null"
        }
      }
    },
    "SamplesClass": {
      "title": "CardSamplesClass",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "match"],
      "properties": {
        "id": {
          "type": "string",
          "description": "类别 id；other 保留给没有命中任何类别的行",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": { "$ref": "#/$defs/LocalizedText" },
        "match": {
          "type": "array",
          "description": "全部条件都成立时命中：写了 dimension 时匹配这一维的取值（取值为 null 时不成立），没写时匹配整行",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["regex"],
            "properties": {
              "dimension": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "regex": { "type": "string", "description": "ECMAScript 语法的正则" }
            }
          }
        }
      }
    },
    "Link": {
      "title": "CardLink",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": {
          "type": "string",
          "description": "explore：按卡片的查询生成数据源浏览链接；dashboard：看板；runbook：领域包内的 runbook",
          "enum": ["explore", "dashboard", "runbook"]
        },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "target": { "type": "string", "description": "dashboard 的 uid 或 runbook 的 <文件>#<锚点>" }
      }
    }
  }
}
