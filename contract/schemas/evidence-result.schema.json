{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srenautix.io/contract/schemas/evidence-result.schema.json",
  "title": "EvidenceResult",
  "description": "一张证据卡在一次研判（或阶段 A 报告）中的结果（DESIGN §6.1）。三种结论之外另有显示状态 capability_missing：所需的数据源能力不可用，和没有数据区分开",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ref",
    "card_id",
    "title",
    "entity",
    "window",
    "verdict",
    "display_state",
    "reason",
    "value",
    "threshold",
    "table",
    "series",
    "queries",
    "egress",
    "evaluated_at"
  ],
  "properties": {
    "ref": { "$ref": "common.schema.json#/$defs/EvidenceRef" },
    "card_id": {
      "type": "string",
      "description": "<pack>/<chain>/<card>；区分性检查产生的卡为 check/<hypothesis id>/<n>",
      "pattern": "^[a-z0-9_][a-z0-9_.-]*/[a-z0-9][a-z0-9_.-]*/[a-z0-9][a-z0-9_-]*$"
    },
    "title": {
      "description": "取自卡片定义，结果脱离定义也能展示",
      "$ref": "evidence-card.schema.json#/$defs/LocalizedText"
    },
    "threshold": { "type": ["number", "null"], "description": "展示用阈值线" },
    "series": {
      "type": "array",
      "description": "每个查询引用的降采样序列（每条不超过 300 点），用于迷你图与实时重跑的并排对比。points 中每项为 [unix 秒, 值或 null]",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "labels", "points"],
        "properties": {
          "ref": { "type": "string", "description": "卡片中的引用名" },
          "labels": { "$ref": "common.schema.json#/$defs/Labels" },
          "points": {
            "type": "array",
            "maxItems": 300,
            "items": {
              "type": "array",
              "tsType": "[number, number | null]",
              "prefixItems": [{ "type": "number" }, { "type": ["number", "null"] }],
              "items": false,
              "minItems": 2
            }
          }
        }
      }
    },
    "entity": {
      "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/EntityRef" }]
    },
    "window": { "$ref": "common.schema.json#/$defs/TimeWindow" },
    "verdict": { "$ref": "common.schema.json#/$defs/Verdict" },
    "display_state": {
      "type": "string",
      "description": "verdict 为 undeterminable 且原因是所需能力不可用时为 capability_missing，其余与 verdict 相同",
      "enum": ["normal", "abnormal", "undeterminable", "capability_missing"]
    },
    "reason": { "$ref": "#/$defs/Reason" },
    "value": { "type": ["string", "null"], "description": "主值的展示文本" },
    "unit": {
      "type": "string",
      "description": "主值、阈值与基线的单位（卡片 display.unit）；没有时为 none",
      "enum": ["none", "percent", "ratio", "bytes", "seconds", "count", "per_second"]
    },
    "table": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["head", "rows"],
          "properties": {
            "head": { "type": "array", "items": { "type": "string" } },
            "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
          }
        }
      ]
    },
    "queries": {
      "type": "array",
      "items": { "$ref": "#/$defs/QueryRecord" }
    },
    "egress": { "$ref": "common.schema.json#/$defs/Egress" },
    "anomaly_started_at": {
      "description": "异常的起始时间，用于 evidence_consistent 判定中的时间条件；无法确定时为 null",
      "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/Timestamp" }]
    },
    "evaluated_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "observations": {
      "type": "object",
      "description": "判定时 let 绑定的标量取值（数值、字符串、布尔），按定义顺序最多 16 个；绑定不可用时为 null。通知与控制台用它展示正常卡的实测值",
      "maxProperties": 16,
      "additionalProperties": { "type": ["number", "string", "boolean", "null"] }
    },
    "params": {
      "type": "object",
      "description": "本次判定生效的 params（卡片默认值与覆盖值合并后），即判定条件里的阈值",
      "additionalProperties": { "type": ["number", "string", "boolean"] }
    },
    "conditions": {
      "type": "array",
      "description": "求值过的判定条件，按求值顺序：undeterminable_if 全部条件，abnormal_if 到第一条命中为止",
      "items": { "$ref": "#/$defs/Condition" }
    },
    "baseline": {
      "type": ["number", "null"],
      "description": "对比基线（卡片 display.baseline 的取值）；卡片没有基线或基线不可用时为 null"
    },
    "impact": {
      "type": "boolean",
      "description": "卡片标为影响类（impact: true），异常时它的值进入通知的影响范围"
    },
    "category": {
      "type": ["string", "null"],
      "description": "卡片定义的业务关键信号类别（EvidenceCardDefinition.category）；没有时为 null，通知按证据链名推断（ADR 0148）",
      "enum": ["storage", "memory", "cpu", "traffic", "blocking", null]
    },
    "value_number": {
      "type": ["number", "null"],
      "description": "主值（display.value）格式化之前的数值，与 threshold 同单位；没有主值或不是有限数时为 null。通知用它判断正常卡是否接近阈值"
    },
    "novelty": {
      "description": "证据基线（契约 2.31.0，ADR 0153）：判为异常的卡在同一实体上、按同样长度的窗口在事件之前的时段重新判定，与事件窗口比较。常态（routine）的卡不能作为根因或支持证据。只对异常卡计算；正常与无法判定的卡、关闭了证据基线的部署为 null 或不出现",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Novelty" }]
    },
    "samples": {
      "description": "错误样例（契约 2.42.0，ADR 0177）：卡片声明了 samples 时出现，其余的卡不出现",
      "$ref": "#/$defs/Samples"
    },
    "controls": {
      "description": "对照结果（契约 2.44.0，ADR 0179）：卡片声明了 controls 时出现。对照对象与故障对象同一时段的判定，对照对象的异常只说明同时段相关，不证明因果",
      "$ref": "#/$defs/Controls"
    }
  },
  "$defs": {
    "Controls": {
      "title": "EvidenceControls",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "by", "subject", "candidates", "results"],
      "properties": {
        "method": { "type": "string", "description": "选择方式，取值与卡片声明的 controls.method 相同", "enum": ["entry_peers"] },
        "by": { "type": "string", "description": "区分对象的标签名" },
        "subject": { "type": "string", "description": "故障对象的键（by 标签的取值），它自己的判定是这张卡的主结果" },
        "candidates": { "type": "integer", "minimum": 0, "description": "同一入口上除故障对象之外可作为对照的对象数" },
        "results": {
          "type": "array",
          "description": "选出的对照对象的判定，先按请求量选出的，后随机选出的",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/ControlResult" }
        }
      }
    },
    "ControlResult": {
      "title": "EvidenceControlResult",
      "description": "一个对照对象的判定，字段含义与 EvidenceResult 的同名字段相同；没有对照对象的序列时 verdict 为 undeterminable",
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "picked_by", "volume", "verdict", "display_state", "reason", "value", "value_number", "anomaly_started_at"],
      "properties": {
        "subject": { "type": "string", "description": "对照对象的键" },
        "picked_by": { "type": "string", "description": "top_n 按请求量选出；sampled 以事件 id 为种子随机选出", "enum": ["top_n", "sampled"] },
        "volume": { "type": ["number", "null"], "description": "排序用的请求量；没有时为 null" },
        "verdict": { "$ref": "common.schema.json#/$defs/Verdict" },
        "display_state": { "type": "string", "enum": ["normal", "abnormal", "undeterminable", "capability_missing"] },
        "reason": { "$ref": "#/$defs/Reason" },
        "value": { "type": ["string", "null"] },
        "value_number": { "type": ["number", "null"] },
        "anomaly_started_at": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/Timestamp" }] }
      }
    },
    "Samples": {
      "title": "EvidenceSamples",
      "description": "按依赖与错误类别聚合的错误日志：维度组合的行数、首末时间与错误类别，每个类别少量脱敏、截断的原始样例。样例与维度值是不可信文本",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "code",
        "lines",
        "truncated",
        "dimensions",
        "groups",
        "groups_omitted",
        "classes",
        "redactions"
      ],
      "properties": {
        "ref": { "type": "string", "description": "卡片中提供日志行的引用名" },
        "code": {
          "description": "没有取得日志行的原因码（contract/reason-codes.json 的 evidence_samples 分组）：samples_deadline 证据期限内没有执行完；samples_timeout 日志查询超时；samples_source_error 日志数据源报错；samples_capability_missing 没有日志能力。取得了日志行（包括零行）时为 null",
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "enum": ["samples_deadline", "samples_timeout", "samples_source_error", "samples_capability_missing"]
            }
          ]
        },
        "lines": { "type": "integer", "minimum": 0, "description": "参与聚合的日志行数" },
        "truncated": {
          "type": "boolean",
          "description": "日志查询返回的行数达到引用的 limit：窗口内还有更早的行，计数与首次时间是下限"
        },
        "dimensions": {
          "type": "array",
          "description": "维度名，按卡片声明的顺序",
          "items": { "type": "string" }
        },
        "groups": {
          "type": "array",
          "description": "维度组合与错误类别的行数，按行数从多到少，最多为卡片的 max_groups",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/SamplesGroup" }
        },
        "groups_omitted": {
          "type": "integer",
          "minimum": 0,
          "description": "超出 max_groups、没有列出的维度组合数"
        },
        "classes": {
          "type": "array",
          "description": "错误类别，按行数从多到少；没有命中任何声明的类别的行为 other",
          "maxItems": 17,
          "items": { "$ref": "#/$defs/SamplesClass" }
        },
        "redactions": {
          "type": "integer",
          "minimum": 0,
          "description": "样例与维度值中被脱敏规则替换的处数"
        }
      }
    },
    "SamplesGroup": {
      "title": "EvidenceSamplesGroup",
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "class", "count", "first_at", "last_at"],
      "properties": {
        "dimensions": {
          "type": "object",
          "description": "维度名 → 取值（脱敏、最多 120 个字符）；标签不存在或正则不匹配时为 null",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "class": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "first_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "last_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "SamplesClass": {
      "title": "EvidenceSamplesClass",
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "title", "count", "samples"],
      "properties": {
        "class": { "type": "string" },
        "title": {
          "description": "卡片声明的类别标题；other 为 null",
          "oneOf": [{ "type": "null" }, { "$ref": "evidence-card.schema.json#/$defs/LocalizedText" }]
        },
        "count": { "type": "integer", "minimum": 1 },
        "samples": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/Sample" }
        }
      }
    },
    "Sample": {
      "title": "EvidenceSample",
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "dimensions", "text", "cut"],
      "properties": {
        "at": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "dimensions": {
          "type": "object",
          "description": "这一行的维度取值",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "text": { "type": "string", "maxLength": 2001, "description": "脱敏后截断的日志行" },
        "cut": { "type": "boolean", "description": "脱敏后的行超过 max_chars，已截断" }
      }
    },
    "Novelty": {
      "title": "EvidenceNovelty",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rule", "value", "comparisons", "samples", "abnormal_share", "range", "reason"],
      "properties": {
        "status": {
          "type": "string",
          "description": "novel：与基线相比明显异常；routine：常态，与基线相比没有明显升高；unknown：得出结论的基线样本不足（更早的时段没有数据、超出保留期，或在期限内没有完成）",
          "enum": ["novel", "routine", "unknown"]
        },
        "rule": {
          "description": "判为常态所依据的规则：abnormal_share 基线样本中判为异常的比例不低于门槛；within_range 主值落在基线样本主值的分位区间内；below_ratio 计数或速率类主值与对照时段的最大值相差不到门槛倍数。不是常态时为 null",
          "oneOf": [{ "type": "null" }, { "type": "string", "enum": ["abnormal_share", "within_range", "below_ratio"] }]
        },
        "value": { "type": ["number", "null"], "description": "事件窗口内的主值（value_number）" },
        "comparisons": {
          "type": "array",
          "description": "固定的对照时段（默认事件前 1 小时、24 小时、7 天的同一时段）上的判定与主值",
          "items": { "$ref": "#/$defs/NoveltyComparison" }
        },
        "samples": {
          "type": "integer",
          "minimum": 0,
          "description": "得出结论（正常或异常）的基线样本数，含对照时段"
        },
        "abnormal_share": {
          "type": ["number", "null"],
          "description": "得出结论的基线样本中判为异常的比例；没有样本时为 null"
        },
        "range": {
          "description": "基线样本主值的分位区间 [1 − quantile, quantile]；有主值的样本不足时为 null",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["low", "high", "quantile"],
              "properties": {
                "low": { "type": "number" },
                "high": { "type": "number" },
                "quantile": { "type": "number", "exclusiveMinimum": 0.5, "maximum": 1 }
              }
            }
          ]
        },
        "reason": { "type": "string", "description": "判定说明" }
      }
    },
    "NoveltyComparison": {
      "title": "EvidenceNoveltyComparison",
      "description": "一个对照时段：offset 为它相对事件窗口提前的时长",
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "window", "verdict", "value"],
      "properties": {
        "offset": { "$ref": "common.schema.json#/$defs/Duration" },
        "window": { "$ref": "common.schema.json#/$defs/TimeWindow" },
        "verdict": { "$ref": "common.schema.json#/$defs/Verdict" },
        "value": { "type": ["number", "null"], "description": "对照时段的主值；没有主值时为 null" }
      }
    },
    "Reason": {
      "title": "EvidenceReason",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {
          "type": "string",
          "description": "rule：命中判定规则；no_data：查询没有样本；partial_data：部分查询没有样本；source_error：数据源报错或超时；capability_missing：所需能力不可用；observability_gap：依赖的目标有 meta 告警；evaluation_error：CEL 求值出错；all_clear：没有命中任何规则；model_judged：只读工具的结果没有 CEL 判定，由小模型对照 refutes_if 判定（可以支持 likely，不能单独支撑 evidence_consistent，展示时标注模型判定）",
          "enum": [
            "rule",
            "no_data",
            "partial_data",
            "source_error",
            "capability_missing",
            "observability_gap",
            "evaluation_error",
            "all_clear",
            "model_judged"
          ]
        },
        "text": { "type": "string", "maxLength": 1000 }
      }
    },
    "Condition": {
      "title": "EvidenceCondition",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cel", "outcome", "say"],
      "properties": {
        "kind": { "type": "string", "enum": ["undeterminable", "abnormal"] },
        "cel": { "type": "string", "description": "条件的 CEL 表达式" },
        "outcome": {
          "type": "string",
          "description": "hit：命中；miss：求值为 false；unavailable：依赖的引用或绑定没有数据，没有求值",
          "enum": ["hit", "miss", "unavailable"]
        },
        "say": {
          "type": ["string", "null"],
          "description": "命中时为条件的 say；没有命中时为条件的 normal_say（卡片提供时），否则为 null"
        }
      }
    },
    "QueryRecord": {
      "title": "EvidenceQueryRecord",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "integration", "capability", "query", "sample_count", "truncated", "error", "duration_ms"],
      "properties": {
        "name": { "type": "string" },
        "integration": { "type": "string", "description": "集成实例 id" },
        "capability": { "type": "string" },
        "query": { "type": "string", "description": "实际执行的查询文本" },
        "sample_count": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "error": { "type": ["string", "null"] },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
