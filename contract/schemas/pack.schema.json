{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srenautix.io/contract/schemas/pack.schema.json",
  "title": "PackManifest",
  "description": "领域包的 pack.yaml（DESIGN §6.3）。领域包只包含数据，不包含可执行代码；其余文件的结构见本文件的 $defs：signals.yaml → SignalsFile，components.yaml → ComponentsFile，alerts.yaml → AlertsFile，chains.yaml → ChainsFile，checks.yaml → ChecksFile，rules.yaml → RulesFile，remediations.yaml → RemediationsFile，rca-params.yaml → RcaParams，knowledge/*.yaml → KnowledgeFile，action-requests.yaml → ActionRequestsFile，chaos/*.yaml → ChaosFile，tests/*.yaml → PackTestFile，用户层文件 → UserLayer，pack.lock → PackLock",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "name", "version", "maturity", "requires"],
  "properties": {
    "api_version": { "const": "srenautix.io/pack/v1" },
    "name": { "type": "string", "pattern": "^[a-z_][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "maturity": {
      "type": "string",
      "description": "stable：有 CI 夹具，并且在 Prometheus 和 VictoriaMetrics 上结论一致；只有 stable 的包计入支持",
      "enum": ["stable", "beta", "draft"]
    },
    "min_srenautix_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "depends_on": {
      "type": "array",
      "description": "依赖的其他包（引用其信号或组件类型）",
      "items": { "type": "string" }
    },
    "requires": {
      "type": "array",
      "description": "必须的集成能力；缺失时整个包禁用并给出原因",
      "items": { "$ref": "#/$defs/Capability" }
    },
    "optional": {
      "type": "array",
      "description": "可选的集成能力；缺失时相应的卡显示 capability_missing",
      "items": { "$ref": "#/$defs/Capability" }
    }
  },
  "$defs": {
    "Capability": {
      "title": "PackCapability",
      "type": "string",
      "description": "<集成类别>.<能力>，例如 metrics.query_range、logs.match、traces.search、changes.list",
      "pattern": "^[a-z]+\\.[a-z_]+$"
    },
    "SignalsFile": {
      "title": "SignalsFile",
      "type": "object",
      "additionalProperties": false,
      "required": ["signals"],
      "properties": {
        "signals": { "type": "array", "items": { "$ref": "#/$defs/Signal" } },
        "templates": {
          "type": "array",
          "description": "区分性检查可用的查询模板（next_checks 的 type=query）",
          "items": { "$ref": "#/$defs/QueryTemplate" }
        }
      }
    },
    "Signal": {
      "title": "Signal",
      "description": "一个信号与它的备选（DESIGN §6.2）。加载时逐个探测，按数据源记录最终选中的一个",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "alternatives"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
        "kind": { "type": "string", "enum": ["metrics", "logs", "traces"] },
        "unit": { "type": "string" },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "description": "按优先级排列",
          "items": { "$ref": "#/$defs/SignalAlternative" }
        }
      }
    },
    "SignalAlternative": {
      "title": "SignalAlternative",
      "type": "object",
      "additionalProperties": false,
      "required": ["expr"],
      "properties": {
        "expr": {
          "type": "string",
          "description": "查询模板。可用变量：$selector（按标签档案展开的实体选择器）、$namespace、$name、$node、$rate_window（由抓取间隔推导）、$params.<名字>"
        },
        "dialect": {
          "type": "string",
          "description": "PromQL 用严格解析器做 lint；使用 MetricsQL 必须显式声明",
          "enum": ["promql", "metricsql", "logql", "logs_match", "traceql"],
          "default": "promql"
        },
        "probe": {
          "type": "string",
          "description": "探测该备选是否可用的查询，返回非空即可用；不填时用 expr 本身探测"
        },
        "recording_rule": {
          "type": "boolean",
          "default": false,
          "description": "expr 依赖录制规则；录制规则可选，下一条备选必须是原始表达式"
        }
      }
    },
    "QueryTemplate": {
      "title": "QueryTemplate",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "signal", "args", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
        "signal": { "type": "string" },
        "args": { "type": "object", "additionalProperties": true, "description": "参数的 JSON Schema（可移植子集）" },
        "description": { "type": "string" },
        "card": {
          "$ref": "evidence-card.schema.json",
          "description": "结果按这张卡判定"
        }
      }
    },
    "ComponentsFile": {
      "title": "ComponentsFile",
      "type": "object",
      "additionalProperties": false,
      "required": ["component_types"],
      "properties": {
        "component_types": { "type": "array", "items": { "$ref": "#/$defs/ComponentType" } },
        "conventions": {
          "type": "array",
          "description": "Operator 约定边，置信度 1.0（例如 CNPG 的 -rw Service 指向它的 Cluster）",
          "items": { "$ref": "#/$defs/OperatorConvention" }
        }
      }
    },
    "ComponentType": {
      "title": "ComponentType",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
        "hub": { "type": "boolean", "default": false },
        "external": {
          "type": "boolean",
          "default": false,
          "description": "组件在集群之外（例如外部 API 服务方），集群内没有可处置的对象：研判根因落在这种组件上、结论为 likely 及以上时，处置推导以它为 ignore 的依据（ADR 0138）"
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string" },
            "api_group": { "type": "string" },
            "labels": { "$ref": "common.schema.json#/$defs/Labels" },
            "name_pattern": { "type": "string", "description": "RE2 正则" },
            "namespaces": { "type": "array", "items": { "type": "string" } }
          }
        },
        "chains": { "type": "array", "items": { "type": "string" } },
        "display_name": {
          "type": "array",
          "minItems": 1,
          "description": "组件的可读名称来源（只影响显示，组件键不变）：按顺序尝试，取第一个非空且不等于实体名的值；都没有时显示组件键。alert_annotation、alert_label 取实体所在告警的注解或标签；signal 在事件锚点对本包的 metrics 信号做 instant 查询，取第一条序列的 label 标签",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["alert_annotation"],
                "properties": { "alert_annotation": { "type": "string", "minLength": 1 } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["alert_label"],
                "properties": { "alert_label": { "type": "string", "minLength": 1 } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["signal", "label"],
                "properties": {
                  "signal": { "type": "string", "minLength": 1 },
                  "label": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    },
    "OperatorConvention": {
      "title": "OperatorConvention",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "relation", "scope"],
      "properties": {
        "id": { "type": "string" },
        "from": { "$ref": "#/$defs/ObjectPattern" },
        "to": { "$ref": "#/$defs/ObjectPattern" },
        "relation": { "type": "string" },
        "scope": { "type": "string", "enum": ["instance", "service"] }
      }
    },
    "ObjectPattern": {
      "title": "ObjectPattern",
      "description": "name 可以引用另一端的捕获组，例如 from 的 name_pattern 为 ^(.+)-rw$ 时 to 的 name 写 $1",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" },
        "name_pattern": { "type": "string" },
        "name": { "type": "string" },
        "same_namespace": { "type": "boolean", "default": true }
      }
    },
    "AlertsFile": {
      "title": "AlertsFile",
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": { "type": "array", "items": { "$ref": "alert-catalog-entry.schema.json" } }
      }
    },
    "ChainsFile": {
      "title": "ChainsFile",
      "type": "object",
      "additionalProperties": false,
      "required": ["chains"],
      "properties": {
        "chains": { "type": "array", "items": { "$ref": "#/$defs/Chain" } }
      }
    },
    "Chain": {
      "title": "EvidenceChain",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "cards"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "title": { "$ref": "evidence-card.schema.json#/$defs/LocalizedText" },
        "runbook": { "type": "string" },
        "cards": { "type": "array", "minItems": 1, "items": { "$ref": "evidence-card.schema.json" } },
        "excludes": {
          "type": "array",
          "description": "排除规则：CEL 表达式命中时阶段 A 的 disposition 为 ignore",
          "items": { "$ref": "evidence-card.schema.json#/$defs/Rule" }
        }
      }
    },
    "ChecksFile": {
      "title": "ChecksFile",
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": { "type": "array", "items": { "$ref": "evidence-card.schema.json" } }
      }
    },
    "RulesFile": {
      "title": "RulesFile",
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": { "type": "array", "items": { "$ref": "#/$defs/Rule" } }
      }
    },
    "Rule": {
      "title": "PackRule",
      "description": "确定性规则提议，只能引用动作目录中已有的动作",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "action", "params", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "title": { "$ref": "evidence-card.schema.json#/$defs/LocalizedText" },
        "when": {
          "type": "string",
          "description": "CEL，可引用 incident、root、cards（卡片 id → 结论）"
        },
        "action": { "type": "string" },
        "params": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "参数值为 CEL 表达式文本"
        },
        "expected_effect": { "$ref": "evidence-card.schema.json#/$defs/LocalizedText" }
      }
    },
    "RemediationsFile": {
      "title": "RemediationsFile",
      "description": "remediations.yaml：修复补丁模板（ADR 0103）。模板生成 Git 补丁，由 server 经 gitops_pr 开 PR，从不合并",
      "type": "object",
      "additionalProperties": false,
      "required": ["remediations"],
      "properties": {
        "remediations": { "type": "array", "items": { "$ref": "#/$defs/Remediation" } }
      }
    },
    "Remediation": {
      "title": "Remediation",
      "description": "一个修复补丁模板。模板只引用仓库角色与文件角色，真实路径由 server 配置的仓库布局（RepositoryLayout）给出，同一模板可用于不同仓库",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "category", "repository", "when", "edits", "change", "verify", "rollback"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "title": { "$ref": "evidence-card.schema.json#/$defs/LocalizedText" },
        "category": {
          "type": "string",
          "description": "release_rollback 发布回退；config_resource 副本数、HPA 上限、request/limit、超时与限流参数；alert_rule 告警阈值、持续时间、严重度；topology_coverage 拓扑与领域包覆盖",
          "enum": ["release_rollback", "config_resource", "alert_rule", "topology_coverage"]
        },
        "repository": { "type": "string", "description": "仓库角色，例如 gitops；server 配置把它映射到仓库与布局" },
        "when": {
          "type": "string",
          "description": "CEL 适用条件。变量：incident、root、research（触发计划的研判结论 {disposition, level}，取值见 Disposition 与 ConclusionLevel；没有研判时为 null）、cards（卡片全局 id → 结论）、alerts（成员告警：alertname、labels、annotations、entity，以及 AlertClassification 的 role、source、catalog_entry、chronic）、params"
        },
        "params": {
          "type": "object",
          "description": "参数默认值，可由用户层覆盖",
          "additionalProperties": { "type": ["number", "string", "boolean"] }
        },
        "inputs": {
          "type": "array",
          "description": "计划时在事件锚点对本包的 metrics 信号做 instant 查询；结果（序列列表）以 name 作为 CEL 变量",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "signal"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
              "signal": { "type": "string" },
              "entity": {
                "type": "string",
                "description": "CEL，求出查询的实体 {kind, namespace, name}，变量与 when 相同；默认为根因。为 null 时模板跳过。例如根因是管理工作负载的 Argo 应用时，用 component_ref 从 incident.components 取工作负载"
              }
            }
          }
        },
        "history": {
          "type": "object",
          "description": "读取一个文件角色的 Git 历史：变量 history 为最近 depth 个修改过它的提交（从新到旧，含当前版本），每项 {commit, author, time, message, doc}",
          "additionalProperties": false,
          "required": ["file", "depth"],
          "properties": {
            "file": { "type": "string" },
            "depth": { "type": "integer", "minimum": 1, "maximum": 50 }
          }
        },
        "let": {
          "type": "array",
          "description": "按顺序求值的 CEL 绑定，后面的绑定、skip_if、edits、change 可以引用。另有变量 files（文件角色 → 文档列表：glob 匹配的全部文件与多文档 YAML 的全部文档按路径顺序展开，单个 JSON 文件为一个元素）与 fields（文件角色 → 逻辑字段 → 点路径）",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "cel"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
              "cel": { "type": "string" }
            }
          }
        },
        "skip_if": {
          "type": "array",
          "description": "任一 CEL 为 true 时不生成补丁，say 写明原因",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cel", "say"],
            "properties": {
              "cel": { "type": "string" },
              "say": { "$ref": "evidence-card.schema.json#/$defs/LocalizedText" }
            }
          }
        },
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/RemediationEdit" }
        },
        "change": {
          "$ref": "evidence-card.schema.json#/$defs/LocalizedText",
          "description": "改了什么、为什么（ICU MessageFormat，变量取自 let 与 params），写入 PR 描述"
        },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "required": ["say"],
          "properties": {
            "say": { "$ref": "evidence-card.schema.json#/$defs/LocalizedText" },
            "cards": {
              "type": "array",
              "description": "合并并同步后应判为正常的卡片全局 id",
              "items": { "type": "string" }
            },
            "within": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" }
          }
        },
        "rollback": {
          "type": "object",
          "description": "回滚方法：revert 这个 PR 的提交；say 写补充说明",
          "additionalProperties": false,
          "required": ["say"],
          "properties": { "say": { "$ref": "evidence-card.schema.json#/$defs/LocalizedText" } }
        }
      }
    },
    "RemediationEdit": {
      "title": "RemediationEdit",
      "description": "对一个文件角色的修改。path 用点路径：段为键名、name[key=value]（数组中 key 等于 value 的元素）、name[*]（任一元素，只用于定位）或 name[N]；{变量} 由 let 与 params 的值替换。文件角色是 glob 或多文档 YAML 时，按 document 与 locate 找到唯一的文档，找不到或不唯一时模板跳过",
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "description": "文件角色" },
        "document": {
          "type": "object",
          "additionalProperties": false,
          "description": "多文档 YAML 中按 kind 与 metadata.name 选文档；两者都可以含 {变量}",
          "properties": { "kind": { "type": "string" }, "name": { "type": "string" } }
        },
        "locate": { "type": "string", "description": "定位文档的点路径，默认取第一个 set 的路径去掉最后一段" },
        "set": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value"],
            "properties": {
              "path": { "type": "string" },
              "field": { "type": "string", "description": "布局 fields 中的逻辑字段名，与 path 二选一" },
              "value": { "type": "string", "description": "CEL；另有变量 current（修改前的值，不存在时为 null）" }
            }
          }
        },
        "append": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "value"],
            "properties": {
              "path": { "type": "string", "description": "数组的点路径" },
              "value": { "type": "string", "description": "CEL，追加的元素" }
            }
          }
        }
      }
    },
    "RepositoryLayout": {
      "title": "RepositoryLayout",
      "description": "仓库布局（server 配置 remediation.repositories.<角色>.files）：文件角色 → 路径、格式与逻辑字段",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "format"],
        "properties": {
          "path": { "type": "string", "description": "仓库内路径，可以是 glob（* 与 **）" },
          "format": { "type": "string", "enum": ["json", "yaml"] },
          "fields": {
            "type": "object",
            "description": "逻辑字段 → 点路径",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "RcaParams": {
      "title": "RcaParams",
      "description": "根因排序参数（DESIGN §5）。修改需要通过回放门禁",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coverage": { "type": "number", "default": 0.4 },
            "precedence": { "type": "number", "default": 0.15 },
            "role_prior": { "type": "number", "default": 0.2 },
            "recent_change": { "type": "number", "default": 0.15 },
            "chronic_penalty": { "type": "number", "default": 0.1 }
          }
        },
        "role_priors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "change": { "type": "number", "default": 1 },
            "cause": { "type": "number", "default": 0.8 },
            "symptom": { "type": "number", "default": 0.3 },
            "forecast": { "type": "number", "default": 0 },
            "meta": { "type": "number", "default": 0 }
          }
        },
        "merge_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.6 },
        "ambiguity_margin": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.1 },
        "adjacency": { "$ref": "common.schema.json#/$defs/Duration", "default": "30m" },
        "change_window": { "$ref": "common.schema.json#/$defs/Duration", "default": "30m" },
        "chronic_window": { "$ref": "common.schema.json#/$defs/Duration", "default": "7d" },
        "chronic_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5,
          "description": "7 天内处于触发状态的时间比例达到该值视为长期告警"
        },
        "hub_min_dependents": { "type": "integer", "minimum": 1, "default": 3 },
        "top_k": { "type": "integer", "minimum": 1, "default": 3 }
      }
    },
    "KnowledgeFile": {
      "title": "KnowledgeFile",
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text", "learned_from", "source"],
            "properties": {
              "id": { "type": "string" },
              "components": { "type": "array", "items": { "type": "string" } },
              "text": { "$ref": "evidence-card.schema.json#/$defs/LocalizedText" },
              "learned_from": {
                "type": "array",
                "description": "来源事件 incident_id 或外部引用；回放时排除来自该用例的部分",
                "items": { "type": "string" }
              },
              "learned_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
              "source": { "type": "string", "enum": ["human", "model"] }
            }
          }
        }
      }
    },
    "ActionRequestsFile": {
      "title": "ActionRequestsFile",
      "description": "动作启用申请；经 Git PR 合入策略之后才生效",
      "type": "object",
      "additionalProperties": false,
      "required": ["requests"],
      "properties": {
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "namespaces", "reason"],
            "properties": {
              "action": { "type": "string" },
              "namespaces": { "type": "array", "items": { "type": "string" } },
              "auto": { "type": "boolean", "default": false },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "UserLayer": {
      "title": "PackUserLayer",
      "description": "用户层文件，按声明的顺序合并（组织在前、集群在后）",
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "target"],
      "properties": {
        "api_version": { "const": "srenautix.io/pack-layer/v1" },
        "target": { "type": "string", "description": "被修改的包名" },
        "params": {
          "type": "object",
          "description": "<chain>/<card> → 参数覆盖",
          "additionalProperties": { "type": "object", "additionalProperties": true }
        },
        "disable": {
          "type": "array",
          "description": "禁用的条目：alerts/<id>、chains/<id>、chains/<id>/<card>、checks/<id>、rules/<id>",
          "items": { "type": "string" }
        },
        "patch": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "value"],
            "properties": {
              "path": { "type": "string", "description": "JSON Pointer，相对包的合并后文档" },
              "value": {}
            }
          }
        },
        "extend": {
          "type": "object",
          "description": "追加的内容，结构同各文件",
          "additionalProperties": false,
          "properties": {
            "signals": { "type": "array", "items": { "$ref": "#/$defs/Signal" } },
            "component_types": { "type": "array", "items": { "$ref": "#/$defs/ComponentType" } },
            "conventions": { "type": "array", "items": { "$ref": "#/$defs/OperatorConvention" } },
            "alerts": { "type": "array", "items": { "$ref": "alert-catalog-entry.schema.json" } },
            "chains": { "type": "array", "items": { "$ref": "#/$defs/Chain" } },
            "checks": { "type": "array", "items": { "$ref": "evidence-card.schema.json" } },
            "rules": { "type": "array", "items": { "$ref": "#/$defs/Rule" } }
          }
        },
        "rca_params": { "$ref": "#/$defs/RcaParams" }
      }
    },
    "ChaosFile": {
      "title": "ChaosFile",
      "description": "面向预发集群的混沌实验配方（DESIGN §14.5）。只包含声明式的 Kubernetes 对象（例如 Chaos Mesh 资源）与期望，不包含脚本",
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "id", "title", "manifests", "duration", "expect"],
      "properties": {
        "api_version": { "const": "srenautix.io/chaos/v1" },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "title": { "$ref": "evidence-card.schema.json#/$defs/LocalizedText" },
        "requires": {
          "type": "array",
          "description": "实验需要的集群组件，例如 chaos-mesh",
          "items": { "type": "string" }
        },
        "manifests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["apiVersion", "kind", "metadata"],
            "properties": {
              "apiVersion": { "type": "string" },
              "kind": { "type": "string" },
              "metadata": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "duration": { "$ref": "common.schema.json#/$defs/Duration" },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_kind", "disposition"],
          "properties": {
            "root_kind": { "type": "string", "description": "期望的根因对象 Kind 或组件类型" },
            "root_name_pattern": { "type": "string" },
            "disposition": { "$ref": "common.schema.json#/$defs/Disposition" },
            "alerts": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "PackTestFile": {
      "title": "PackTestFile",
      "description": "领域包测试（DESIGN §6.3）。input_series 使用 promtool 的序列写法，在 Prometheus 与 VictoriaMetrics 上各跑一遍，结论必须一致",
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "interval", "tests"],
      "properties": {
        "api_version": { "const": "srenautix.io/pack-test/v1" },
        "interval": { "$ref": "common.schema.json#/$defs/Duration" },
        "input_series": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["series", "values"],
            "properties": {
              "series": { "type": "string", "description": "例如 kube_pod_info{namespace=\"shop\",pod=\"pg-1\"}" },
              "values": { "type": "string", "description": "promtool 的展开写法，例如 0+1x10 _ stale" }
            }
          }
        },
        "input_logs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["labels", "lines"],
            "properties": {
              "labels": { "$ref": "common.schema.json#/$defs/Labels" },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["offset", "line"],
                  "properties": {
                    "offset": { "$ref": "common.schema.json#/$defs/Duration" },
                    "line": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "eval_time", "card", "entity", "expect"],
            "properties": {
              "name": { "type": "string" },
              "eval_time": { "$ref": "common.schema.json#/$defs/Duration" },
              "card": { "type": "string", "description": "<chain>/<card> 或 checks/<id>" },
              "entity": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "name"],
                "properties": {
                  "kind": { "type": "string" },
                  "namespace": { "type": ["string", "null"] },
                  "name": { "type": "string" }
                }
              },
              "params": {
                "type": "object",
                "additionalProperties": { "type": ["number", "string", "boolean"] }
              },
              "expect": {
                "type": "object",
                "additionalProperties": false,
                "required": ["verdict"],
                "properties": {
                  "verdict": { "$ref": "common.schema.json#/$defs/Verdict" },
                  "display_state": {
                    "type": "string",
                    "enum": ["normal", "abnormal", "undeterminable", "capability_missing"]
                  },
                  "reason_kind": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "PackLock": {
      "title": "PackLock",
      "description": "pack.lock：每个包与用户层的内容哈希；每次研判和评测都记录 lock 本身的哈希",
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "packs", "layers"],
      "properties": {
        "api_version": { "const": "srenautix.io/pack-lock/v1" },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "source", "digest"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "source": { "type": "string", "description": "builtin、git+<url>@<sha> 或 oci://<ref>@<digest>" },
              "digest": { "$ref": "common.schema.json#/$defs/Sha256" }
            }
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": { "type": "string" },
              "digest": { "$ref": "common.schema.json#/$defs/Sha256" }
            }
          }
        }
      }
    }
  }
}
