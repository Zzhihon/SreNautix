{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srenautix.io/contract/schemas/research-output.schema.json",
  "title": "ResearchOutput",
  "description": "一次研判经代码校验后的输出（DESIGN §7.2、§7.3），由 worker 写入 research_runs 并随 research.concluded 发布。模型直接输出的部分见 contract/model/；本结构加入假设账本状态、区分性检查结果、代码判定的结论阶梯和校验记录",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disposition",
    "conclusion",
    "hypotheses",
    "next_checks",
    "situation",
    "summary",
    "recommendations",
    "proposals",
    "validation_notes"
  ],
  "properties": {
    "disposition": { "$ref": "common.schema.json#/$defs/Disposition" },
    "conclusion": { "$ref": "#/$defs/Conclusion" },
    "hypotheses": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/Hypothesis" }
    },
    "next_checks": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/NextCheck" }
    },
    "situation": { "type": "string", "maxLength": 300 },
    "summary": { "type": "string", "maxLength": 400 },
    "recommendations": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/Recommendation" }
    },
    "proposals": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/ProposalDraft" }
    },
    "validation_notes": {
      "type": "array",
      "description": "代码校验的修改记录：删除的无效证据引用、删除的目录外提议、降级的结论、删除的无法核实的数值等",
      "items": { "type": "string" }
    },
    "ignore_basis": {
      "type": "string",
      "description": "处置为 ignore 时成立的确定性依据（契约 2.38.0，ADR 0138、0167、0168、0170）：stage_a 阶段 A 已判为 ignore；planned_retirement 全部成员告警由计划内的退役解释；external 研判根因是集群外部组件；evidence_normal 得出结论的卡全部正常；impact_normal 影响卡全部正常。处置不是 ignore 时不填",
      "enum": ["stage_a", "planned_retirement", "external", "evidence_normal", "impact_normal"]
    },
    "stop_reason": {
      "type": ["string", "null"],
      "description": "检验循环的停止原因：leader_supported 第一的假设得到支持且竞争假设都已推翻或检验后无法判定；no_change 连续两步没有变化或没有可执行的检查；step_limit、deadline、budget 达到步数、期限或预算上限；model_unavailable 模型不可用；指纹不变直接沿用上一次研判时为 no_change",
      "enum": ["leader_supported", "no_change", "step_limit", "deadline", "budget", "model_unavailable", null]
    },
    "check_cards": {
      "type": "array",
      "description": "区分性检查产生的证据卡（引用编号接在阶段 A 的卡之后），序列为空数组；完整序列在 worker 的运行明细中",
      "maxItems": 12,
      "items": { "$ref": "evidence-result.schema.json" }
    },
    "last_resort_route": {
      "type": "object",
      "description": "结论由兜底路由（ModelRoute.role 为 last_resort）给出时填写：全部常规路由都因事件涉及其故障域而提前熔断（契约 2.30.0，ADR 0152）。常规路由给出结论时不填",
      "additionalProperties": false,
      "required": ["route_id", "model"],
      "properties": {
        "route_id": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "evidence_index": {
      "type": "array",
      "description": "研判运行内的证据引用到定义与实体的映射（同研判清单的 evidence_map）：卡为 <card_id>@<实体键>，告警为 alert_id，变更为 change_id",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "target"],
        "properties": {
          "ref": { "$ref": "common.schema.json#/$defs/EvidenceRef" },
          "target": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "CauseScope": {
      "title": "CauseScope",
      "description": "local 仓库声明的组件自身的运行状态；configuration 仓库声明的组件的配置、资源或参数，或经管理它的 GitOps 应用生效的发布与清单变更；downstream 调用方或消费方；upstream 被依赖的服务方（集群外部的服务方、其他团队的服务）；infrastructure 节点、存储、网络等基础设施；unknown 无法判断",
      "type": "string",
      "enum": ["local", "configuration", "downstream", "upstream", "infrastructure", "unknown"]
    },
    "Conclusion": {
      "title": "ResearchConclusion",
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "hypothesis_id", "root_component", "undetermined_reason", "consistency"],
      "properties": {
        "level": { "$ref": "common.schema.json#/$defs/ConclusionLevel" },
        "hypothesis_id": { "type": ["string", "null"], "pattern": "^h[1-9]$" },
        "root_component": {
          "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/ComponentKey" }]
        },
        "undetermined_reason": { "type": ["string", "null"], "maxLength": 400 },
        "consistency": { "$ref": "#/$defs/ConsistencyChecks" },
        "consistency_detail": { "$ref": "#/$defs/ConsistencyDetail" },
        "cause_scope": {
          "description": "选中根因所在的范围（契约 2.38.0，ADR 0170）：模型给出，代码按确定性依据校正。根因是领域包声明在集群之外的组件时为 upstream；根因不由 GitOps 仓库负责（处置依据的 repository_owned）时不能是 local 或 configuration；结论为 undetermined 或没有选中根因时为 unknown。之前的研判输出没有这个字段",
          "$ref": "#/$defs/CauseScope"
        }
      }
    },
    "ConsistencyDetail": {
      "title": "ConsistencyDetail",
      "description": "四个条件各自的依据，由结论阶梯的代码给出：支持卡、支持的成员告警、最早的异常起点、症状起点与容差、相反的正常卡、检验过与同样得到支持的竞争假设、结论由谁选中",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_refs",
        "model_judged_refs",
        "support_alerts",
        "onset",
        "symptom_onset_at",
        "tolerance_seconds",
        "contrary_refs",
        "tested_competitors",
        "supported_competitors",
        "chosen_by"
      ],
      "properties": {
        "support_refs": {
          "type": "array",
          "description": "由领域包规则判定、实体在假设范围内的异常卡",
          "items": { "$ref": "common.schema.json#/$defs/EvidenceRef" }
        },
        "support_alerts": {
          "type": "array",
          "description": "计入支持的成员告警（ADR 0122）；只有它们支持时档位最高为 likely",
          "items": { "$ref": "common.schema.json#/$defs/EvidenceRef" }
        },
        "supported_competitors": {
          "type": "array",
          "description": "同样处于支持状态的竞争假设（ADR 0124）；不为空时第 4 个条件不满足",
          "items": { "type": "string", "pattern": "^h[1-9]$" }
        },
        "chosen_by": {
          "type": "string",
          "description": "model：模型在 conclude 中选中；ledger：模型弃权，由代码按账本选中（ADR 0120，档位最高为 likely）",
          "enum": ["model", "ledger"]
        },
        "model_judged_refs": {
          "type": "array",
          "description": "由小模型判定的支持卡（只能支持 likely）",
          "items": { "$ref": "common.schema.json#/$defs/EvidenceRef" }
        },
        "onset": {
          "description": "支持卡中最早的异常起点；没有可确定起点的支持卡时为 null",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "at"],
              "properties": {
                "ref": { "$ref": "common.schema.json#/$defs/EvidenceRef" },
                "at": { "$ref": "common.schema.json#/$defs/Timestamp" }
              }
            }
          ]
        },
        "symptom_onset_at": {
          "description": "症状起点：最早触发的 symptom 角色成员告警，没有时为事件首次触发时间",
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "tolerance_seconds": { "type": "integer", "minimum": 0 },
        "contrary_refs": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/EvidenceRef" }
        },
        "tested_competitors": {
          "type": "array",
          "description": "执行过检查或已被推翻的竞争假设",
          "items": { "type": "string", "pattern": "^h[1-9]$" }
        }
      }
    },
    "ConsistencyChecks": {
      "title": "ConsistencyChecks",
      "description": "evidence_consistent 的四个条件逐项结果（DESIGN §7.3）；四项全为 true 才是 evidence_consistent",
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_in_scope", "onset_precedes_symptom", "no_contrary_normal", "competitor_tested"],
      "properties": {
        "entity_in_scope": { "type": "boolean" },
        "onset_precedes_symptom": { "type": "boolean" },
        "no_contrary_normal": { "type": "boolean" },
        "competitor_tested": { "type": "boolean" }
      }
    },
    "Hypothesis": {
      "title": "Hypothesis",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parent_id", "root_component", "mechanism", "supporting", "refuting", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^h[1-9]$" },
        "parent_id": { "type": ["string", "null"], "pattern": "^h[1-9]$" },
        "root_component": { "$ref": "common.schema.json#/$defs/ComponentKey" },
        "mechanism": { "type": "string", "maxLength": 600 },
        "supporting": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "common.schema.json#/$defs/EvidenceRef" }
        },
        "refuting": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "common.schema.json#/$defs/EvidenceRef" }
        },
        "status": {
          "type": "string",
          "description": "假设账本状态：pending 待检验；supported 支持；refuted 推翻；inconclusive 检验后仍无法判定",
          "enum": ["pending", "supported", "refuted", "inconclusive"]
        },
        "status_reasons": {
          "type": "array",
          "description": "账本给出状态的依据，按时间顺序，例如“支持卡：card:31、card:38”“相反的正常卡：card:25”“人工反馈确认根因”",
          "items": { "type": "string", "maxLength": 500 }
        },
        "checks_run": {
          "type": "integer",
          "minimum": 0,
          "description": "针对这个假设执行完成的区分性检查数（失败的检查不计）"
        }
      }
    },
    "NextCheck": {
      "title": "NextCheck",
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "type", "template", "args", "refutes_if", "purpose", "result_ref", "outcome"],
      "properties": {
        "hypothesis_id": { "type": "string", "pattern": "^h[1-9]$" },
        "type": { "type": "string", "enum": ["query", "tool"] },
        "template": { "type": "string" },
        "args": { "type": "object", "additionalProperties": true },
        "refutes_if": { "type": "string", "maxLength": 300 },
        "purpose": { "type": "string", "maxLength": 300 },
        "result_ref": {
          "description": "控制器执行后得到的卡；未执行时为 null",
          "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/EvidenceRef" }]
        },
        "outcome": {
          "type": "string",
          "enum": ["not_run", "supports", "refutes", "inconclusive", "failed"]
        },
        "error": {
          "type": ["string", "null"],
          "description": "outcome 为 failed 时的原因（参数被拒绝、数据源报错、结果无法判定成卡）"
        }
      }
    },
    "Recommendation": {
      "title": "Recommendation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "rationale",
        "steps",
        "owner",
        "risk",
        "risk_note",
        "runbook_ref",
        "action_id",
        "hypothesis_id",
        "evidence_refs",
        "generated_by"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^r[0-9]{1,2}$" },
        "kind": { "type": "string", "enum": ["mitigation", "root_fix", "prevention", "investigation"] },
        "title": { "type": "string", "maxLength": 120 },
        "rationale": { "type": "string", "maxLength": 400 },
        "steps": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "maxLength": 500 } },
        "owner": { "type": "string", "enum": ["platform", "app", "vendor", "oncall"] },
        "risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "risk_note": { "type": ["string", "null"], "maxLength": 300 },
        "runbook_ref": { "type": ["string", "null"] },
        "action_id": { "type": ["string", "null"] },
        "hypothesis_id": { "type": "string", "pattern": "^h[1-9]$" },
        "evidence_refs": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "common.schema.json#/$defs/EvidenceRef" }
        },
        "generated_by": {
          "type": "string",
          "description": "model 的建议在消息与控制台中标注模型生成",
          "enum": ["model", "rule"]
        }
      }
    },
    "ProposalDraft": {
      "title": "ProposalDraft",
      "description": "研判产生的提议草稿，经 server 的提议中转写入 proposals",
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "params", "hypothesis_id", "expected_effect", "proposal_id"],
      "properties": {
        "action_id": { "type": "string" },
        "params": { "type": "object", "additionalProperties": true },
        "hypothesis_id": { "type": "string", "pattern": "^h[1-9]$" },
        "expected_effect": { "type": "string", "maxLength": 300 },
        "proposal_id": {
          "description": "提议中转接受后的 id；被拒绝时为 null",
          "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/Uuid" }]
        }
      }
    }
  }
}
