{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srenautix.io/contract/schemas/eval-snapshot.schema.json",
  "title": "EvalSnapshot",
  "description": "用例的查询邻域快照（DESIGN §14.2 snapshot 模式）：用例被提升时固化研判所需的全部输入与两跳以内组件的数据源调用结果。回放只从快照读取（VCR）；快照中没有的调用返回不可用并计入未命中率。日常研判不录制快照",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "case_id",
    "format_version",
    "window",
    "as_of",
    "context",
    "queries",
    "created_at",
    "source"
  ],
  "properties": {
    "snapshot_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "case_id": { "type": "string" },
    "format_version": { "type": "integer", "const": 1 },
    "window": {
      "description": "快照窗口：工具与查询模板只能查询这个窗口内的数据",
      "$ref": "common.schema.json#/$defs/TimeWindow"
    },
    "as_of": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "context": { "$ref": "#/$defs/Context" },
    "queries": {
      "description": "数据源调用的录制结果（VCR），与领域包的 pack test --replay 使用同一种查询快照",
      "$ref": "#/$defs/QuerySnapshot"
    },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "code_sha", "pack_lock"],
      "properties": {
        "kind": {
          "type": "string",
          "description": "promoted：控制台或 API 提升用例时固化；imported：从外部种子导入；scenario：场景运行后固化；reconstructed：评测时从保留期内的数据重建（阶段 A 与研判输入按当前代码重新生成）",
          "enum": ["promoted", "imported", "scenario", "reconstructed"]
        },
        "ref": { "type": ["string", "null"], "description": "导入来源（格式名、版本、文件与记录）" },
        "code_sha": { "type": ["string", "null"] },
        "pack_lock": {
          "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/Sha256" }]
        }
      }
    }
  },
  "$defs": {
    "Context": {
      "title": "EvalSnapshotContext",
      "description": "阶段 B 的输入（与 worker 从中心读取的研判上下文同形）。卡片判定、拓扑与动作目录都是固化时的结果",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident",
        "stage_a",
        "subgraph",
        "alerts",
        "actions",
        "runbooks",
        "knowledge",
        "cases",
        "templates"
      ],
      "properties": {
        "incident": { "$ref": "incident.schema.json" },
        "stage_a": { "$ref": "stage-a-report.schema.json" },
        "subgraph": {
          "type": "object",
          "description": "根因两跳内的拓扑（与 OpenAPI 的 Subgraph 同形）",
          "additionalProperties": false,
          "required": ["topology_version", "root", "nodes", "edges"],
          "properties": {
            "topology_version": { "type": "integer", "minimum": 0 },
            "root": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/ComponentKey" }] },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["component", "kind", "namespace", "name", "role", "alerts", "hops"],
                "properties": {
                  "component": { "$ref": "common.schema.json#/$defs/ComponentKey" },
                  "kind": { "type": "string" },
                  "namespace": { "type": ["string", "null"] },
                  "name": { "type": "string" },
                  "role": { "type": "string", "enum": ["root", "candidate", "member", "neighbor"] },
                  "alerts": { "type": "array", "items": { "type": "string" } },
                  "hops": { "type": "integer", "minimum": 0, "maximum": 2 }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to", "relation", "provenance", "confidence", "scope"],
                "properties": {
                  "from": { "$ref": "common.schema.json#/$defs/ComponentKey" },
                  "to": { "$ref": "common.schema.json#/$defs/ComponentKey" },
                  "relation": { "type": "string" },
                  "provenance": { "$ref": "topology-event.schema.json#/$defs/Provenance" },
                  "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                  "scope": { "type": "string", "enum": ["instance", "service"] }
                }
              }
            }
          }
        },
        "alerts": { "type": "array", "items": { "$ref": "alert.schema.json" } },
        "actions": {
          "type": "array",
          "description": "固化时本集群启用、可用于这个事件的动作",
          "items": { "$ref": "../gateway/v1/action-catalog.schema.json#/$defs/action" }
        },
        "runbooks": { "type": "array", "items": { "type": "string" } },
        "knowledge": {
          "type": "array",
          "description": "可检索的知识条目（带 learned_from，回放时按用例排除）",
          "items": { "$ref": "#/$defs/Knowledge" }
        },
        "cases": {
          "type": "array",
          "description": "可检索的参考案例（回放时只取 resolved_at 早于用例开始时间的）",
          "items": { "$ref": "#/$defs/ReferenceCase" }
        },
        "templates": {
          "type": "array",
          "description": "区分性检查可用的查询模板",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "args"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "args": { "type": "object" }
            }
          }
        },
        "disposition_facts": { "$ref": "#/$defs/DispositionFacts" }
      }
    },
    "DispositionFacts": {
      "title": "EvalDispositionFacts",
      "description": "处置推导的确定性依据（ADR 0138），与 server 写进研判输入的相同；旧快照没有这个字段",
      "type": "object",
      "additionalProperties": false,
      "required": ["external", "remediations"],
      "properties": {
        "external": {
          "type": "array",
          "description": "子图中组件类型声明为集群外部（external）的组件",
          "items": { "$ref": "common.schema.json#/$defs/ComponentKey" }
        },
        "declared": {
          "type": "array",
          "description": "候选根因中由 GitOps 仓库声明的运行中组件（ADR 0162）：沿 owned_by 的顶层属主由 GitOps 应用管理（managed_by）；管理着候选根因的 GitOps 应用与逻辑组件不在其中。修改仓库中的声明就能处置这些组件；契约 2.34.0 之前的快照没有这个字段",
          "items": { "$ref": "common.schema.json#/$defs/ComponentKey" }
        },
        "repository_owned": {
          "type": "array",
          "description": "候选根因中由 GitOps 仓库负责的组件（ADR 0170）：declared 的全部组件，加上管理着候选根因的 GitOps 应用（发布与清单的变更经它们从仓库生效），以及映射到由 GitOps 应用管理的工作负载的逻辑组件。根因范围只有在研判根因属于它们时才能是 local 或 configuration，自愈 PR 的仓库事实同样按它判断；契约 2.38.0 之前的快照没有这个字段",
          "items": { "$ref": "common.schema.json#/$defs/ComponentKey" }
        },
        "business_impact": {
          "type": "array",
          "description": "触发中的业务影响告警（ADR 0163、0166）：事件成员中状态为 firing、满足 server 的 notify.business_impact_alerts 的告警 id（契约 2.36.0 起严重度写在匹配器里，2.34.0、2.35.0 的 server 另外要求 critical）。有这些告警并且有异常卡时处置不能是 ignore；契约 2.34.0 之前的快照没有这个字段",
          "items": { "type": "string" }
        },
        "remediations": {
          "type": "array",
          "description": "候选根因 → 适用的修复模板（release_rollback、config_resource 两类中启用的类别），按研判以它为根因、处置为 act 求值；没有适用模板的根因不列出",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["root", "templates"],
            "properties": {
              "root": { "$ref": "common.schema.json#/$defs/ComponentKey" },
              "templates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["key", "category"],
                  "properties": { "key": { "type": "string" }, "category": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "Knowledge": {
      "title": "EvalKnowledge",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "components", "text", "learned_from", "learned_at", "source"],
      "properties": {
        "id": { "type": "string" },
        "components": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" },
        "learned_from": { "type": "array", "items": { "type": "string" } },
        "learned_at": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/Timestamp" }] },
        "source": { "type": "string", "enum": ["human", "model"] }
      }
    },
    "ReferenceCase": {
      "title": "EvalReferenceCase",
      "type": "object",
      "additionalProperties": false,
      "required": ["incident_id", "label", "root_component", "mechanism", "resolved_at", "source"],
      "properties": {
        "incident_id": { "type": "string" },
        "label": { "type": "string" },
        "root_component": { "$ref": "common.schema.json#/$defs/ComponentKey" },
        "mechanism": { "type": ["string", "null"] },
        "resolved_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "source": { "type": "string", "enum": ["human", "model"] }
      }
    },
    "QuerySnapshot": {
      "title": "QuerySnapshot",
      "description": "查询快照 srenautix.io/query-snapshot/v1：请求按去掉 clock_window 之后的规范 JSON（JCS）与操作名组成键，回放时按键读取，没有的请求为快照未命中",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "snapshot_id",
        "recorded_at",
        "clock_window",
        "ids",
        "capabilities",
        "metrics_dialects",
        "label_profile",
        "logs_profile",
        "entries",
        "cases"
      ],
      "properties": {
        "api_version": { "const": "srenautix.io/query-snapshot/v1" },
        "snapshot_id": { "type": "string" },
        "recorded_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "clock_window": { "$ref": "common.schema.json#/$defs/TimeWindow" },
        "ids": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metrics", "logs", "traces"],
          "properties": {
            "metrics": { "type": ["string", "null"] },
            "logs": { "type": ["string", "null"] },
            "traces": { "type": ["string", "null"] }
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "metrics.query",
              "metrics.query_range",
              "metrics.series",
              "logs.match",
              "logs.query",
              "traces.search"
            ]
          }
        },
        "metrics_dialects": { "type": "array", "items": { "type": "string", "enum": ["promql", "metricsql"] } },
        "label_profile": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "../integrations/metrics/v1/metrics.schema.json#/$defs/LabelProfile" }
          ]
        },
        "logs_profile": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["namespace", "pod", "container", "cluster"],
          "properties": {
            "namespace": { "type": "string" },
            "pod": { "type": "string" },
            "container": { "type": "string" },
            "cluster": { "type": ["string", "null"] }
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "request"],
            "properties": {
              "op": {
                "type": "string",
                "enum": ["query", "query_range", "metric_exists", "logs_match", "logs_query", "traces_search"]
              },
              "request": { "type": "object", "description": "集成契约的请求，去掉 clock_window" },
              "result": { "description": "集成契约的结果；有 error 时不填" },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "message"],
                "properties": {
                  "kind": { "type": "string", "enum": ["datasource", "capability_missing"] },
                  "message": { "type": "string" }
                }
              }
            }
          }
        },
        "cases": {
          "type": "array",
          "description": "pack test 的期望（卡片、实体、锚点、期望判定）；评测快照为空",
          "items": { "type": "object" }
        }
      }
    }
  }
}
