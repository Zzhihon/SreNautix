{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srenautix.io/contract/schemas/stage-a-report.schema.json",
  "title": "StageAReport",
  "description": "阶段 A 的确定性报告（DESIGN §7.1）：不调用模型，不经过 worker。事件创建或版本变化后立即生成",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "incident_id",
    "incident_version",
    "disposition",
    "disposition_reason",
    "candidates",
    "ambiguous",
    "cards",
    "evidence_fingerprint",
    "observability_blind",
    "timeline",
    "runbooks",
    "rule_proposals",
    "degraded",
    "rendered_at"
  ],
  "properties": {
    "report_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "incident_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "incident_version": { "type": "integer", "minimum": 1 },
    "disposition": { "$ref": "common.schema.json#/$defs/Disposition" },
    "disposition_reason": {
      "type": "string",
      "description": "suppressed：命中抑制规则；pack_exclude：命中领域包的排除规则；planned_retirement：全部成员告警由带 planned_by 的退役解释，并且没有业务影响告警（契约 2.36.0）；forecast_or_chronic_only：只有 forecast 和长期告警；rule_action：有动作明确的规则提议；critical_ambiguous：critical 且根因有歧义；observability_blind：观测失明；default：其余情况",
      "enum": [
        "suppressed",
        "pack_exclude",
        "planned_retirement",
        "forecast_or_chronic_only",
        "rule_action",
        "critical_ambiguous",
        "observability_blind",
        "default"
      ]
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "incident.schema.json#/$defs/RootCandidate" }
    },
    "ambiguous": { "type": "boolean" },
    "cards": {
      "type": "array",
      "description": "证据卡的判定向量；正常卡表示被排除嫌疑",
      "items": { "$ref": "evidence-result.schema.json" }
    },
    "evidence_fingerprint": {
      "description": "判定向量的指纹（带迟滞，见 docs/core/convergence.md）",
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "observability_blind": { "type": "boolean" },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "kind", "text", "ref"],
        "properties": {
          "at": { "$ref": "common.schema.json#/$defs/Timestamp" },
          "kind": { "type": "string", "enum": ["alert_firing", "alert_resolved", "change", "card_abnormal"] },
          "text": { "type": "string" },
          "ref": { "type": ["string", "null"] }
        }
      }
    },
    "runbooks": {
      "type": "array",
      "items": { "type": "string", "description": "<pack>/<runbook 文件>#<锚点>" }
    },
    "rule_proposals": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Uuid" }
    },
    "degraded": {
      "type": "boolean",
      "description": "状态库降级：PG 不可用时在内存中生成，消息带降级横幅"
    },
    "rendered_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "required_evidence": {
      "type": "array",
      "description": "成员告警的最低取证集合（契约 2.31.0，ADR 0153）：目录条目声明了 required_cards、能解析出实体的在场成员告警，每条一项。旧版本的报告没有这个字段",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alert_id", "alertname", "catalog_entry", "entity", "cards", "missing"],
        "properties": {
          "alert_id": { "type": "string" },
          "alertname": { "type": "string" },
          "catalog_entry": { "type": "string", "description": "<pack>/<条目 id>" },
          "entity": { "$ref": "common.schema.json#/$defs/EntityRef" },
          "cards": {
            "type": "array",
            "description": "最低取证集合中的卡（<pack>/<chain>/<card>）",
            "items": { "type": "string" }
          },
          "missing": {
            "type": "array",
            "description": "阶段 A 没有在告警实体上得出结论（没有执行，或无法判定）的卡",
            "items": { "type": "string" }
          }
        }
      }
    },
    "rule_conclusions": {
      "type": "array",
      "description": "领域包的确定性结论规则（conclusions.yaml，契约 2.43.0，ADR 0178）命中的结论，按根因候选的排名排列（候选之外的组件在后），同一规则在同一组件上只出一条，最多 3 条。研判可用时它们作为假设 h7–h9 进入账本；没有阶段 B 结论时，群消息与事件详情显示它们并标明“规则判定”。契约 2.43.0 之前的报告没有这个字段",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/RuleConclusion" }
    }
  },
  "$defs": {
    "RuleConclusion": {
      "title": "RuleConclusion",
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "title", "root_component", "mechanism", "level", "basis", "card_conditions"],
      "properties": {
        "rule_id": {
          "type": "string",
          "description": "<pack>/<规则 id>",
          "pattern": "^[a-z_][a-z0-9-]*/[a-z0-9][a-z0-9_-]*$"
        },
        "title": { "$ref": "evidence-card.schema.json#/$defs/LocalizedText" },
        "root_component": { "$ref": "common.schema.json#/$defs/ComponentKey" },
        "mechanism": { "$ref": "evidence-card.schema.json#/$defs/LocalizedText" },
        "level": {
          "type": "string",
          "description": "规则判定的档位，上限与 ADR 0122 只有成员告警支持时相同",
          "const": "likely"
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "description": "满足条件的证据：card:<n>（本报告的卡）、alert:<n>（成员告警，按事件成员顺序）、change:<n>（事件的变更），按条件顺序，去重",
          "items": { "$ref": "common.schema.json#/$defs/EvidenceRef" }
        },
        "card_conditions": {
          "type": "array",
          "description": "规则的证据卡条件（告警与变更条件是已经发生的事实，不在这里）。阶段 B 的区分性检查在其中一个卡片定义上得出确定的结论、并且不满足这个条件时（实体在根因范围内，on 为 incident 时不限实体），规则判定被推翻；没有卡片条件的规则不会被检查推翻",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["card", "verdict", "observations", "on"],
            "properties": {
              "card": { "type": "string", "description": "<pack>/<chain>/<card>" },
              "verdict": { "type": "string", "enum": ["abnormal", "normal"] },
              "observations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "op", "value"],
                  "properties": {
                    "name": { "type": "string" },
                    "op": { "type": "string", "enum": ["gt", "gte", "lt", "lte", "eq", "ne"] },
                    "value": { "type": ["number", "string", "boolean"] }
                  }
                }
              },
              "on": { "type": "string", "enum": ["self", "incident"] }
            }
          }
        }
      }
    }
  }
}
