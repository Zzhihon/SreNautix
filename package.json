{
  "name": "srenautix-workspace",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "contract:gen": "pnpm --filter @srenautix/contract run gen",
    "contract:check": "pnpm --filter @srenautix/contract run gen:check",
    "ci": "pnpm run lint && pnpm run contract:check && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "overrides": {
      "react-router-dom-v5-compat>react-router": "7.18.4"
    }
  }
}
