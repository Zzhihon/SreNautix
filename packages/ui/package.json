{
  "name": "@srenautix/ui",
  "version": "0.1.0",
  "description": "SreNautix React components: primitives, domain components and shared views fed through an injected DataPort",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@srenautix/source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./grafana": {
      "@srenautix/source": "./src/theme/grafana.ts",
      "types": "./dist/types/theme/grafana.d.ts",
      "default": "./dist/grafana.js"
    },
    "./messages/zh-CN.json": "./src/i18n/zh-CN.json",
    "./messages/en.json": "./src/i18n/en.json",
    "./style.css": "./dist/ui.css"
  },
  "files": [
    "dist",
    "src/i18n/*.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "PLAYWRIGHT_BROWSERS_PATH=../../.scratch/ms-playwright vitest run",
    "browsers": "PLAYWRIGHT_BROWSERS_PATH=../../.scratch/ms-playwright playwright install chromium-headless-shell"
  },
  "peerDependencies": {
    "@grafana/data": ">=12.1.7",
    "@tanstack/react-query": "^5.90.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@grafana/data": {
      "optional": true
    }
  },
  "dependencies": {
    "@srenautix/contract": "workspace:*",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.21",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "intl-messageformat": "12.1.3",
    "lucide-react": "1.59.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@grafana/data": "13.2.4",
    "@tanstack/react-query": "5.104.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
