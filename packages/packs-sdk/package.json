{
  "name": "@srenautix/packs-sdk",
  "version": "0.1.0",
  "description": "SreNautix 领域包 SDK：包 schema 与加载、分层与 pack.lock、信号层与标签档案、严格 PromQL lint、CEL 判定与序列函数库、pack test 与 doctor",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@srenautix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./business": {
      "@srenautix/source": "./src/business.ts",
      "types": "./dist/business.d.ts",
      "default": "./dist/business.js"
    }
  },
  "bin": {
    "srenautix-pack": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:kps-conditions": "tsx scripts/kps-conditions.ts",
    "gen:upstream-conditions": "tsx scripts/upstream-conditions.ts"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@marcbachmann/cel-js": "8.0.0",
    "@srenautix/contract": "workspace:*",
    "@srenautix/integration-sdk": "workspace:*",
    "ajv": "8.20.0",
    "canonicalize": "5.1.0",
    "diff": "9.0.0",
    "intl-messageformat": "12.1.3",
    "jsonpointer": "5.0.1",
    "mustache": "4.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/mustache": "4.2.6"
  }
}
