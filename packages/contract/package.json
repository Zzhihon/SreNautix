{
  "name": "@srenautix/contract",
  "version": "2.10.0",
  "description": "SreNautix 契约的 TypeScript 类型与 JSON Schema 校验器，由 contract/ 生成",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@srenautix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "tsx scripts/gen.ts",
    "gen:check": "tsx scripts/gen.ts --check",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "yaml": "2.9.1"
  }
}
